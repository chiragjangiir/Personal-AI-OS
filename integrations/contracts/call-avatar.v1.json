{
  "version": 1,
  "inputs": {
    "call_avatar": {
      "definition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "call_id",
          "avatar",
          "avatar_revision"
        ],
        "properties": {
          "operation": {
            "const": "call_avatar"
          },
          "call_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
          },
          "avatar": {
            "type": "boolean"
          },
          "avatar_revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "confirmed_quote": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "quote_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "price_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "scope_text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "quote_id",
              "price_text",
              "scope_text"
            ]
          },
          "control_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
          }
        }
      },
      "error": "FORMAL_CALL_AVATAR_INVALID"
    }
  },
  "outputs": {
    "call_avatar_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operation",
        "session_id",
        "call_id",
        "state",
        "avatar",
        "avatar_revision"
      ],
      "properties": {
        "schema_version": {
          "const": "paios.central.text-envelope.v1"
        },
        "operation": {
          "const": "call_avatar_state"
        },
        "session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
        },
        "state": {
          "enum": [
            "opening",
            "connecting",
            "live",
            "closing",
            "closed",
            "failed"
          ]
        },
        "error_code": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "app_id",
            "channel_id",
            "user_id",
            "token",
            "token_expire_at"
          ],
          "properties": {
            "provider": {
              "const": "artc"
            },
            "app_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "channel_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "user_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "token": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "token_expire_at": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "audio_input": {
              "type": "string",
              "enum": [
                "gateway"
              ]
            }
          }
        },
        "avatar": {
          "type": "boolean"
        },
        "avatar_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
