diff --git a/hermes_state_memory_outcomes.py b/hermes_state_memory_outcomes.py
new file mode 100644
index 0000000000000000000000000000000000000000..810d791e6fe281ed145058a677987cca278846c5
--- /dev/null
+++ b/hermes_state_memory_outcomes.py
@@ -0,0 +1,247 @@
+"""Native memory effects in SessionDB; no memory content or transcript projection."""
+import time
+import uuid
+import math
+import re
+from pathlib import Path
+
+
+MEMORY_OUTCOME_SCHEMA = """
+CREATE TABLE IF NOT EXISTS memory_effect_runs (
+ run_id TEXT PRIMARY KEY, session_id TEXT NOT NULL, profile_home TEXT NOT NULL,
+ started_at REAL NOT NULL, finished_at REAL,
+ memory_write INTEGER
+);
+CREATE TABLE IF NOT EXISTS memory_effect_attempts (
+ attempt_ref TEXT PRIMARY KEY, run_id TEXT NOT NULL, session_id TEXT NOT NULL,
+ tool_call_id TEXT NOT NULL, operation TEXT NOT NULL, target TEXT NOT NULL,
+ predecessor_ref TEXT, pending_id TEXT, started_at REAL NOT NULL,
+ UNIQUE(run_id, tool_call_id)
+);
+CREATE TABLE IF NOT EXISTS memory_effect_settlements (
+ receipt_ref TEXT PRIMARY KEY, attempt_ref TEXT NOT NULL UNIQUE,
+ status TEXT NOT NULL, pending_id TEXT, settled_at REAL NOT NULL,
+ FOREIGN KEY(attempt_ref) REFERENCES memory_effect_attempts(attempt_ref)
+);
+CREATE INDEX IF NOT EXISTS memory_effect_run_idx ON memory_effect_attempts(run_id);
+"""
+
+
+def _text(value, limit):
+    if not isinstance(value, str) or not 0 < len(value) <= limit:
+        raise ValueError("invalid native memory identity")
+
+
+def _reference(value, kind):
+    if not isinstance(value, str) or re.fullmatch("memory-" + kind + ":[a-f0-9]{32}", value) is None:
+        raise ValueError("invalid native memory reference")
+
+
+def _epoch(value):
+    if not isinstance(value, (int, float)) or isinstance(value, bool) or not math.isfinite(value) or value < 0:
+        raise ValueError("invalid native memory time")
+
+
+def _predecessor(effect, predecessor):
+    if (not predecessor or predecessor["status"] != "pending_approval"
+            or any(effect[key] != predecessor[key] for key in ("run_id", "session_id", "pending_id", "target"))
+            or not effect["pending_id"]
+            or effect["operation"] not in (predecessor["operation"], "reject")):
+        raise ValueError("invalid native memory predecessor")
+
+
+def _memory_source(run_id, session_id, profile_home, status, error, receipts=(), unsettled=()):
+    return {"memory_receipt_source": {
+        "schema": "hermes.memory_source.v2", "source": "l2", "profile_home": profile_home,
+        "run_id": run_id, "session_id": session_id, "status": status, "error": error,
+        "receipts": list(receipts), "unsettled_attempts": list(unsettled),
+    }}
+
+
+def memory_source_failure(run_id, session_id, profile_home, error):
+    return _memory_source(run_id, session_id, profile_home, "failed", error)
+
+
+class SessionMemoryOutcomesMixin:
+    def _memory_effect_session(self, conn, run_id, active_session_id):
+        run = conn.execute("SELECT session_id, profile_home FROM memory_effect_runs WHERE run_id=?", (run_id,)).fetchone()
+        if not run or run["profile_home"] != str(Path(self.db_path).parent.resolve()):
+            raise ValueError("native memory run/profile binding mismatch")
+        scope = run["session_id"]
+        tip = self.resolve_resume_session_id(scope, _conn=conn)
+        if tip != active_session_id:
+            raise ValueError("native memory transcript is not the canonical resume target")
+        live = conn.execute("SELECT ended_at FROM sessions WHERE id=?", (active_session_id,)).fetchone()
+        if active_session_id != scope and not live or live and live["ended_at"] is not None:
+            raise ValueError("native memory transcript is not a live native continuation")
+        return scope
+
+    def memory_effect_session(self, run_id, active_session_id):
+        """Fixed API conversation scope, proved against its canonical native transcript."""
+        _text(run_id, 512)
+        _text(active_session_id, 512)
+        with self._read_ctx() as conn:
+            conn.execute("SAVEPOINT native_memory_scope")
+            try:
+                return self._memory_effect_session(conn, run_id, active_session_id)
+            finally:
+                conn.execute("RELEASE native_memory_scope")
+
+    def begin_memory_effect_run(self, run_id, session_id, *, memory_write=None):
+        _text(run_id, 512)
+        _text(session_id, 512)
+        home = str(Path(self.db_path).parent.resolve())
+        now = time.time()
+        _epoch(now)
+        if memory_write is not None and type(memory_write) is not bool:
+            raise ValueError("invalid native memory permission")
+        self._write_sql("""INSERT INTO memory_effect_runs
+                        (run_id, session_id, profile_home, started_at, finished_at, memory_write)
+                        VALUES (?,?,?,?,NULL,?)""", (run_id, session_id, home, now, memory_write))
+
+    def memory_effect_write_policy(self, run_id, session_id):
+        run = self._read_one("SELECT session_id, profile_home, memory_write FROM memory_effect_runs WHERE run_id=?", (run_id,))
+        if (not run or run["session_id"] != session_id
+                or run["profile_home"] != str(Path(self.db_path).parent.resolve())):
+            raise ValueError("native memory permission scope mismatch")
+        return None if run["memory_write"] is None else run["memory_write"] == 1
+
+    def finish_memory_effect_run(self, run_id):
+        now = time.time()
+        _epoch(now)
+        self._write_sql("UPDATE memory_effect_runs SET finished_at=? WHERE run_id=?", (now, run_id))
+
+    def begin_memory_effect(self, run_id, session_id, tool_call_id, operation, target,
+                            *, predecessor_ref=None, pending_id=None, active_session_id=None):
+        for value in (run_id, session_id, tool_call_id):
+            _text(value, 512)
+        operation = operation[:32]
+        target = target[:32]
+        _text(operation, 32)
+        _text(target, 32)
+        if pending_id is not None:
+            _text(pending_id, 256)
+        if predecessor_ref is not None:
+            _reference(predecessor_ref, "receipt")
+        elif pending_id is not None:
+            raise ValueError("native pending resolution needs a predecessor")
+        ref = "memory-attempt:" + uuid.uuid4().hex
+        now = time.time()
+        _epoch(now)
+        def write(conn):
+            if active_session_id is not None and self._memory_effect_session(conn, run_id, active_session_id) != session_id:
+                raise ValueError("native memory conversation scope changed")
+            run = conn.execute("SELECT session_id, profile_home FROM memory_effect_runs WHERE run_id=?", (run_id,)).fetchone()
+            if not run or run["session_id"] != session_id or run["profile_home"] != str(Path(self.db_path).parent.resolve()):
+                raise ValueError("memory run/session binding mismatch")
+            if predecessor_ref is not None:
+                predecessor = conn.execute("""SELECT a.run_id, a.session_id, a.target, a.operation, s.status, s.pending_id FROM memory_effect_attempts a
+                    JOIN memory_effect_settlements s USING(attempt_ref) WHERE s.receipt_ref=?""", (predecessor_ref,)).fetchone()
+                _predecessor({"run_id": run_id, "session_id": session_id, "pending_id": pending_id,
+                              "target": target, "operation": operation}, predecessor)
+            if conn.execute("SELECT COUNT(*) FROM memory_effect_attempts WHERE run_id=?", (run_id,)).fetchone()[0] >= 256:
+                raise ValueError("memory outcome bound exceeded")
+            conn.execute("INSERT INTO memory_effect_attempts VALUES (?,?,?,?,?,?,?,?,?)",
+                         (ref, run_id, session_id, tool_call_id, operation, target, predecessor_ref, pending_id, now))
+        self._execute_write(write)
+        return ref
+
+    def settle_memory_effect(self, attempt_ref, status, pending_id=None):
+        if status not in {"committed", "unchanged", "pending_approval", "failed", "rejected"}:
+            raise ValueError("invalid memory settlement")
+        _reference(attempt_ref, "attempt")
+        if pending_id is not None:
+            _text(pending_id, 256)
+        if status == "pending_approval" and pending_id is None:
+            raise ValueError("native pending settlement needs its pending identity")
+        ref = "memory-receipt:" + uuid.uuid4().hex
+        now = time.time()
+        _epoch(now)
+        def write(conn):
+            attempt = conn.execute("""SELECT a.pending_id, a.predecessor_ref, a.session_id, r.profile_home,
+                r.session_id AS run_session_id FROM memory_effect_attempts a JOIN memory_effect_runs r USING(run_id)
+                WHERE a.attempt_ref=?""", (attempt_ref,)).fetchone()
+            if (not attempt or attempt["session_id"] != attempt["run_session_id"]
+                    or attempt["profile_home"] != str(Path(self.db_path).parent.resolve())
+                    or attempt["predecessor_ref"] is not None and attempt["pending_id"] != pending_id):
+                raise ValueError("native memory settlement binding mismatch")
+            conn.execute("INSERT INTO memory_effect_settlements VALUES (?,?,?,?,?)", (ref, attempt_ref, status, pending_id, now))
+        self._execute_write(write)
+        return ref
+
+    def read_memory_effects(self, run_id, session_id=None):
+        # One SQLite statement observes coverage and settlements at one durable snapshot.
+        rows = self._read_all("""SELECT a.*, s.receipt_ref, s.status, s.pending_id AS settled_pending_id,
+            s.settled_at, r.session_id AS run_session_id, r.profile_home, r.started_at AS run_started_at, r.finished_at, r.memory_write
+            FROM memory_effect_runs r LEFT JOIN memory_effect_attempts a USING(run_id)
+            LEFT JOIN memory_effect_settlements s USING(attempt_ref)
+            WHERE r.run_id=? ORDER BY a.started_at, a.attempt_ref""", (run_id,))
+        if not rows:
+            return memory_source_failure(run_id, session_id or "", str(Path(self.db_path).parent.resolve()),
+                                         "NATIVE_MEMORY_RUN_NOT_INSTRUMENTED")
+        run = rows[0]
+        if session_id is not None and run["run_session_id"] != session_id:
+            raise ValueError("memory run/session binding mismatch")
+        _text(run_id, 512)
+        _text(run["run_session_id"], 512)
+        _epoch(run["run_started_at"])
+        if run["profile_home"] != str(Path(self.db_path).parent.resolve()):
+            raise ValueError("native memory profile binding mismatch")
+        if run["memory_write"] not in (None, 0, 1):
+            raise ValueError("invalid native memory permission")
+        if run["finished_at"] is not None:
+            _epoch(run["finished_at"])
+        if len(rows) > 256:
+            raise ValueError("memory outcome bound exceeded")
+        receipts = []
+        for row in rows:
+            if row["attempt_ref"] is None:
+                continue
+            _reference(row["attempt_ref"], "attempt")
+            _epoch(row["started_at"])
+            for key, limit in (("tool_call_id", 512), ("operation", 32), ("target", 32)):
+                _text(row[key], limit)
+            if row["session_id"] != run["run_session_id"]:
+                raise ValueError("memory run/session binding mismatch")
+            if row["receipt_ref"] is not None:
+                if run["memory_write"] == 0 and row["status"] not in {"rejected", "failed"}:
+                    raise ValueError("readonly native run cannot claim a memory settlement")
+                _reference(row["receipt_ref"], "receipt")
+                _epoch(row["settled_at"])
+                if row["status"] not in {"committed", "unchanged", "pending_approval", "failed", "rejected"}:
+                    raise ValueError("invalid memory settlement")
+            elif row["settled_at"] is not None or row["status"] is not None:
+                raise ValueError("native memory settlement identity missing")
+            if row["settled_pending_id"] is not None:
+                _text(row["settled_pending_id"], 256)
+            if row["pending_id"] is not None:
+                _text(row["pending_id"], 256)
+            if (row["predecessor_ref"] is not None and row["receipt_ref"] is not None
+                    and row["pending_id"] != row["settled_pending_id"]):
+                raise ValueError("native memory settlement binding mismatch")
+            pending = row["settled_pending_id"] or row["pending_id"]
+            if pending is not None:
+                _text(pending, 256)
+            if row["status"] == "pending_approval" and pending is None:
+                raise ValueError("native pending settlement needs its pending identity")
+            if row["predecessor_ref"] is not None:
+                _reference(row["predecessor_ref"], "receipt")
+            receipts.append({"schema": "hermes.memory_receipt.v1", "receipt_ref": row["receipt_ref"] or row["attempt_ref"],
+                             "attempt_ref": row["attempt_ref"], "profile_home": run["profile_home"],
+                             "run_id": run_id, "session_id": row["session_id"], "tool_call_id": row["tool_call_id"],
+                             "operation": row["operation"], "target": row["target"],
+                             "status": row["status"] or "unknown", "created_at": row["started_at"],
+                             "settled_at": row["settled_at"], "pending_id": pending,
+                             "predecessor_ref": row["predecessor_ref"]})
+        by_receipt = {r["receipt_ref"]: r for r in receipts}
+        for receipt in receipts:
+            if receipt["predecessor_ref"] is not None:
+                _predecessor(receipt, by_receipt.get(receipt["predecessor_ref"]))
+        unknown = run["finished_at"] is None or any(r["status"] == "unknown" for r in receipts)
+        # Project once at the source. Every native record survives in exactly one partition.
+        settled = [{"receipt_ref": receipt["receipt_ref"], "status": receipt["status"],
+                    "kind": "l2", "summary": receipt} for receipt in receipts if receipt["status"] != "unknown"]
+        unsettled = [receipt for receipt in receipts if receipt["status"] == "unknown"]
+        return _memory_source(run_id, run["run_session_id"], run["profile_home"],
+                              "partial" if unknown else "complete",
+                              "NATIVE_MEMORY_COVERAGE_UNKNOWN" if unknown else None, settled, unsettled)
