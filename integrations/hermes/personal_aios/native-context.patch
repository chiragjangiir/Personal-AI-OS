+"""Actual native HTTP body await/control race; no model/provider requests."""
+import asyncio
+import json
+import threading
+from pathlib import Path
+from unittest.mock import MagicMock
+
+import pytest
+from aiohttp.test_utils import TestClient, TestServer
+
+from agent.interrupt_control import InterruptControlMixin
+from gateway.platforms import api_server_runs, api_server
+from tests.gateway.test_api_server_runs import _make_adapter, _create_runs_app
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize('transition', ['completed', 'stopping', 'replaced', 'scope', 'key', 'normal'])
+async def test_native_http_slow_body_rechecks_live_owner(transition, monkeypatch):
+    adapter = _make_adapter('fixture-only-key')
+    ready, finish = threading.Event(), threading.Event()
+    agent = MagicMock()
+    agent.session_id = 'fixture-native-session'
+    agent._pending_steer_lock = threading.Lock()
+    agent._pending_steer = None
+    agent.steer = InterruptControlMixin.steer.__get__(agent)
+    def controlled_turn(**kwargs):
+        ready.set()
+        assert finish.wait(10), 'test-owned worker not released'
+        return {'final_response': 'fixture completed', 'completed': True}
+    agent.run_conversation.side_effect = controlled_turn
+    monkeypatch.setattr(adapter, '_create_agent', lambda **kwargs: agent)
+    entered, release = asyncio.Event(), asyncio.Event()
+    original_read = adapter._read_json_body
+    async def observe_read(request):
+        entered.set()
+        return await original_read(request)
+    monkeypatch.setattr(adapter, '_read_json_body', observe_read)
+    async def slow_bytes():
+        yield b'{"input":'
+        await release.wait()
+        yield b'"late exact revision"}'
+    headers = {'Authorization': 'Bearer fixture-only-key'}
+    task = None
+    async with TestClient(TestServer(_create_runs_app(adapter))) as client:
+        try:
+            start = await client.post('/v1/runs', json={'input': 'controlled turn'}, headers={**headers, 'Idempotency-Key': 'fixture-run'})
+            assert start.status == 202, await start.text()
+            run_id = (await start.json())['run_id']
+            worker_task = adapter._active_run_tasks[run_id]
+            for _ in range(200):
+                if ready.is_set(): break
+                await asyncio.sleep(.005)
+            assert ready.is_set()
+            task = asyncio.create_task(client.post(f'/v1/runs/{run_id}/steer', data=slow_bytes(), headers=headers))
+            await asyncio.wait_for(entered.wait(), 3)
+            replacement = None
+            if transition == 'completed':
+                finish.set()
+                await asyncio.wait_for(asyncio.shield(worker_task), 3)
+                assert run_id not in adapter._active_run_agents
+            elif transition == 'stopping':
+                response = await client.post(f'/v1/runs/{run_id}/stop', headers=headers)
+                assert response.status == 200
+            elif transition == 'replaced':
+                replacement = MagicMock()
+                replacement.steer.return_value = True
+                adapter._active_run_agents[run_id] = replacement
+            elif transition == 'scope':
+                adapter._run_owners[run_id] = 'expired-or-foreign-scope'
+            elif transition == 'key':
+                adapter._api_key = 'changed-fixture-key'
+            release.set()
+            response = await asyncio.wait_for(task, 3)
+            body = await response.json()
+            expected = 200 if transition == 'normal' else 404 if transition == 'scope' else 401 if transition == 'key' else 409
+            observations = {'transition':transition, 'http_status':response.status, 'body':body,
+                'run_status':dict(adapter._run_statuses[run_id]), 'pending_steer':agent._pending_steer}
+            root = Path(__file__).resolve().parents[3]
+            if (root/'PRIVATE-MIRROR-MANIFEST.json').exists():
+                (root/'evidence'/('http-'+transition+'.json')).write_text(json.dumps(observations, indent=2)+'\n')
+            assert response.status == expected, observations
+            assert agent._pending_steer == ('late exact revision' if transition == 'normal' else None)
+            if replacement: replacement.steer.assert_not_called()
+            if transition == 'completed':
+                assert adapter._run_statuses[run_id]['status'] == 'completed'
+                durable = adapter._run_idempotency_store.status_for_run(adapter._run_owners[run_id], run_id)
+                assert durable['status']['status'] == 'completed'
+                adapter._run_statuses.pop(run_id)
+                get = await client.get(f'/v1/runs/{run_id}', headers=headers)
+                assert get.status == 200
+                assert (await get.json())['status'] == 'completed'
+            elif transition == 'stopping':
+                assert adapter._run_statuses[run_id]['status'] == 'stopping'
+        finally:
+            release.set(); finish.set()
+            if task and not task.done(): await task
+            if 'worker_task' in locals(): await asyncio.wait_for(asyncio.shield(worker_task), 3)
+            adapter._run_idempotency_store.close()
+            if adapter._session_db is not None: adapter._session_db.close()
+
