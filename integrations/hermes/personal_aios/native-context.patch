+            'prior_reports are job-bound OUT snapshots; local_reports are same-session text, not delivery receipts. '
+            'agent_reports are model claims, including saved note bodies, not verified causes. '
+            'completion_events contain runtime metadata and source records; schema_valid verifies format only. '
+            'Use confirmation_receipts, task_records and source_failure with their recorded scope; quoted assertions remain attributed.\n'
+            + json.dumps({'prior_reports': reports, 'local_reports': local_reports,
+                          'agent_reports': agent_reports, 'completion_events': completion_events}, ensure_ascii=False))
+
+
+
+def _fields(record, names):
+    return {key: record[key] for key in names if key in record}
+
+
+def _phone_record(record):
+    projected = _fields(record, ('job_id', 'app', 'task', 'title', 'state', 'status', 'success',
+        'terminal_reason', 'answer', 'started_at', 'finished_at', 'step', 'max_steps',
+        'self_check_of', 'subject', 'body', 'recipient', 'partial_findings', 'spool_state', 'report_absorbed',
+        'execution', 'delivery', 'task_retry_allowed'))
+    if 'delivery_failure' in record:
+        projected['delivery_failure'] = _fields(record['delivery_failure'], ('error_code', 'failed_at', 'stage', 'reason'))
+    if 'trace' in record:
+        trace = record['trace']
+        timing = ('index', 'started_at', 'ended_at', 'elapsed_seconds', 'model_wait_seconds',
+                  'action', 'tool_result_status', 'waiting_for', 'status')
+        projected['trace'] = _fields(trace, ('truncated_steps',))
+        if 'in_progress' in trace:
+            projected['trace']['in_progress'] = (_fields(trace['in_progress'], timing)
+                                                  if trace['in_progress'] is not None else None)
+        if 'steps' in trace:
+            projected['trace']['steps'] = [_fields(step, timing) for step in trace['steps']]
+    return projected
+
+
+def task_records(messages):
+    """Carry source task fields, not the child's interpretation or unrelated tool payloads."""
+    calls, records = {}, []
+    for message in messages:
+        for call in message.get('tool_calls') or []:
+            function = call.get('function', {})
+            name = function.get('name')
+            if name not in ('phone_task', 'phone_status', 'mcp__phone__phone_task',
+                            'mcp__phone__phone_status', 'mcp__self__runtime_query', 'skills_hub'):
+                continue
+            request = tool_result_record(function.get('arguments'))
+            if request is None:
+                continue
+            calls[call['id']] = (name, request)
+        if message.get('role') != 'tool' or message.get('tool_call_id') not in calls:
+            continue
+        name, request = calls[message['tool_call_id']]
+        result = tool_result_record(message.get('content'))
+        if result is None:
+            continue
+        if name == 'skills_hub' and request.get('action') == 'release_decide':
+            request = _fields(request, ('action', 'value'))
+            result = _fields(result, ('request_id', 'state', 'base', 'commit', 'approved',
+                'principal_id', 'decided_at', 'confirmation_id', 'confirmed_by', 'confirmed_at', 'surface',
+                'decision_status', 'decision', 'decision_source', 'choice', 'reason', 'lifecycle', 'reused',
+                'confirmation_evidence'))
+        elif name in ('phone_task', 'mcp__phone__phone_task'):
+            request = _fields(request, ('goal', 'app', 'title', 'tier', 'subject', 'body', 'recipient')) | (
+                {'effect': _fields(request['effect'], ('kind', 'recipient', 'task_type', 'summary'))}
+                if isinstance(request.get('effect'), dict) else {})
+            result = _phone_record(result)
+        elif name in ('phone_status', 'mcp__phone__phone_status'):
+            request = _fields(request, ('job_id',))
+            result = {'jobs': [_phone_record(job) for job in result['jobs']]} if 'jobs' in result else _phone_record(result)
+        elif request.get('source') == 'errands' and result.get('source') == 'errands':
+            request = _fields(request, ('source', 'text', 'since', 'until', 'limit'))
+            retained = result['hermes']
+            result = {**_fields(result, ('source', 'as_of', 'since', 'until')),
+                **_fields(retained, ('status', 'scope', 'truncated'))}
+            if 'records' in retained:
+                result['records'] = [_phone_record(record) for record in retained['records']]
+        elif request.get('source') == 'release' and result.get('source') == 'release':
+            request = _fields(request, ('source', 'request_id', 'since', 'until', 'limit'))
+            result = {**_fields(result, ('source', 'as_of', 'since', 'until')),
+                **_fields(result['hermes'], ('status', 'runtime', 'runtime_status', 'records',
+                    'pending_rollback_requests', 'observation_facts', 'scope', 'truncated'))}
+        else:
+            continue
+        records.append({'tool_call_id': message['tool_call_id'], 'tool': name,
+                        'request': request, 'result': result})
+    return records
+
+
+def authored_tool_records(messages):
+    """Carry Kanban storage receipt scope without promoting caller-authored content."""
+    calls, records = {}, []
+    for message in messages:
+        if message.get('role') == 'assistant':
+            for call in message.get('tool_calls') or []:
+                if call.get('function', {}).get('name') == 'kanban_create':
+                    calls[call['id']] = 'kanban_create'
+        if message.get('role') != 'tool' or message.get('tool_call_id') not in calls:
+            continue
+        result = tool_result_record(message.get('content'))
+        if not result or result.get('ok') is not True or 'content_provenance' not in result:
+            continue
+        records.append({'tool_call_id': message['tool_call_id'], 'tool': calls[message['tool_call_id']],
+                        'input_source': 'assistant', **_fields(result, ('task_id', 'status',
+                            'receipt_scope', 'content_provenance'))})
+    return records
+
+
+def request_report_facts(agent, messages):
+    """Reproject retained source records for this request; never change transcript state."""
+    principal = getattr(agent, '_paios_principal_id', None)
+    if not principal:
+        return None
+    source_fields = ('kind', 'id', 'job_id', 'task', 'title', 'source', 'status', 'terminal_reason', 'error',
+                     'error_code', 'stage', 'reason', 'execution', 'delivery', 'task_retry_allowed',
+                     'evidence_ref', 'self_check_of', 'run_id', 'processed_event_id')
+    packet = {'kind': 'paios.authoritative_report_facts',
+              'scope': {'principal_id': principal, 'session_id': agent.session_id}}
+    for key, value in (('confirmation_receipts', confirmation_receipts(messages)),
+                       ('task_records', task_records(messages)),
+                       ('authored_tool_records', authored_tool_records(messages))):
+        if value:
+            packet[key] = value
+    source = getattr(agent, '_paios_failure_context', None)
+    if source:
+        packet['source_failure'] = _fields(source, source_fields)
+    completion, errand = None, None
+    for message in messages:
+        text = message.get('content')
+        if message.get('role') != 'system' or not isinstance(text, str):
+            continue
+        if text.startswith('Native delegated work completed.'):
+            # The runtime may append a selfcheck instruction after the JSON packet.
+            completion, _ = json.JSONDecoder().raw_decode(text.split('\n', 1)[1])
+        else:
+            d = tool_result_record(text)
+            if d and d.get('principal_id') == principal and d.get('origin') == 'device_observation':
+                app = d.get('content', {}).get('app_event', {})
+                if isinstance(app, dict) and app.get('kind') in {'errand_result', 'errand_delivery_failed', 'task_failure'}:
+                    errand = {'processed_event_id': d['processed_event_id'],
+                              'kind': app['kind'], **_phone_record(app), **_fields(app, source_fields)}
+    if errand:
+        packet['errand_records'] = [errand]
+    if completion:
+        if completion.get('prior_reports'):
+            packet['prior_reports'] = completion['prior_reports']
+        if completion.get('local_reports'):
+            packet['local_reports'] = completion['local_reports']
+        records = []
+        for event in completion.get('completion_events', []):
+            for entry in event.get('results', [event]):
+                record = _fields(entry, ('task_index', 'session_id', 'task_scope', 'confirmation_receipts', 'task_records', 'authored_tool_records'))
+                record.update(_fields(event, ('completion_scope',)))
+                if entry.get('source_failure'):
+                    record['source_failure'] = _fields(entry['source_failure'], source_fields)
+                record.update(_fields(entry, ('execution', 'delivery', 'task_retry_allowed', 'evidence_ref')))
+                if any(key in record for key in ('task_scope', 'confirmation_receipts', 'task_records', 'authored_tool_records', 'source_failure', 'execution', 'delivery')):
+                    records.append({'delegation_id': event['delegation_id'], **record})
+        if records:
+            packet['completion_records'] = records
+    if len(packet) == 2:
+        return None
+    return {'role': 'system', 'content': 'Retained source records for this response. Use their exact scope; '
+            'prior_reports distinguish generated text from publication and acknowledgement; local_reports are already generated '
+            'session text, not verified results or delivery receipts. Task prior_report_refs index this packet prior_reports; '
+            'they bind only matching jobs, not all siblings in a completion_scope. '
+            'Tool prose and model summaries do not override these records.\n'
+            + json.dumps(packet, ensure_ascii=False)}
