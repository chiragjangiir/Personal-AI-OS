+"""Personal-AIOS speaker run scope (gateway/run_scope.py): a guest voice runs isolated from the owner's transcript and
+memory with chat/web/reply tools only; an uncertain owner voice keeps the owner session with the same tool allowlist."""
+import asyncio
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+from aiohttp import web
+from aiohttp.test_utils import TestClient, TestServer
+
+from gateway import run_scope
+from gateway.config import PlatformConfig
+from gateway.platforms.api_server import APIServerAdapter
+
+AUTH = {"Authorization": "Bearer test-native-key", "X-Hermes-Run-Contract": "hermes.run.v2"}
+OWNER_TOOLS = ["memory", "session_search", "phone_task", "send_message", "skill_view", "delegate_task", "terminal",
+               "web_search", "web_extract", "todo_list", "paios_open_reply", "paios_l3_query", "paios_action_request", "paios_l5_read",
+               "phone_cancel", "phone_continue", "paios_l3_commit", "future_effect_tool", "paios_health_query", "paios_terminal_question", "paios_call_offer"]
+
+
+def _tool(name):
+    return {"type": "function", "function": {"name": name, "parameters": {"type": "object", "properties": {}}}}
+
+
+def _agent():
+    agent = MagicMock()
+    agent.tools = [_tool(name) for name in OWNER_TOOLS]
+    agent.valid_tool_names = set(OWNER_TOOLS)
+    agent._memory_store = object()
+    agent.run_conversation.return_value = {"final_response": "ok"}
+    agent.session_prompt_tokens = agent.session_completion_tokens = agent.session_total_tokens = 0
+    return agent
+
+
+def _plain_agent():
+    return SimpleNamespace(tools=[_tool(name) for name in OWNER_TOOLS], valid_tool_names=set(OWNER_TOOLS), _memory_store=object(),
+                           _guardrail_block_result=None)
+
+
+def _app(adapter):
+    app = web.Application()
+    app.router.add_post("/v1/runs", adapter._handle_runs)
+    app.router.add_get("/v1/runs/{run_id}", adapter._handle_get_run)
+    return app
+
+
+async def _start(body, history=None):
+    adapter = APIServerAdapter(PlatformConfig(enabled=True, extra={"key": "test-native-key"}))
+    loaded, created = [], {}
+
+    async def conversation_history(session_id):
+        loaded.append(session_id)
+        return list((history or {}).get(session_id, []))
+
+    adapter._conversation_history_for_session = conversation_history
+    agent = _agent()
+    agent._session_db = adapter._ensure_session_db()
+
+    def create_agent(**kwargs):
+        from hermes_constants import get_hermes_home
+        created["profile_home"] = get_hermes_home()
+        from agent.secret_scope import get_secret
+        created["model_key"] = get_secret("BUILD_MODEL_KEY")
+        created["private_env"] = get_secret("OWNER_PRIVATE_DATA")
+        created.update(kwargs)
+        run_scope.restrict_agent(agent, kwargs.get("run_scope"))
+        agent.session_id = kwargs["session_id"]
+        agent._ensure_db_session.side_effect = lambda: agent._session_db.ensure_session(agent.session_id, "api_server")
+        def answer(**call):
+            created["model_history"] = call.get("conversation_history")
+            created["tool_conversation"] = getattr(agent, "_paios_tool_conversation", None)
+            db = agent._session_db
+            row = db.get_session(agent.session_id)
+            created["hidden_before_model"] = bool(row and row["hidden"])
+            created["listed_sessions"] = [row["id"] for row in db.list_sessions_rich()]
+            return {"final_response": "ok"}
+        agent.run_conversation.side_effect = answer
+        return agent
+
+    with patch.object(adapter, "_create_agent", side_effect=create_agent):
+        async with TestClient(TestServer(_app(adapter))) as client:
+            response = await client.post("/v1/runs", json=body, headers=AUTH)
+            data = await response.json()
+            if response.status == 202:
+                for _ in range(200):
+                    status = await (await client.get(f"/v1/runs/{data['run_id']}", headers=AUTH)).json()
+                    if status["status"] in {"completed", "failed", "cancelled"}:
+                        break
+                    await asyncio.sleep(0.02)
+    if response.status == 202:
+        created["terminal"] = status
+    return response.status, data, loaded, created, agent
+
