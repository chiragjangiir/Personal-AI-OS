index 0000000000000000000000000000000000000000..fe8552f84424782fa3c09e45f4ad48c0d3662429
--- /dev/null
+++ b/tools/memory_tool_outcomes.py
@@ -0,0 +1,233 @@
+"""Source-owned attribution for builtin writes and later native approval commands."""
+import json
+import logging
+from contextvars import ContextVar
+from pathlib import Path
+from typing import TypedDict, Optional
+
+from hermes_constants import get_hermes_home
+from gateway.session_context import (get_api_run_id, current_api_memory_write,
+    api_memory_write_allowed, memory_write_policy_required)
+
+logger = logging.getLogger(__name__)
+_current_attempt = ContextVar("native_memory_attempt", default=None)
+
+
+class NativePendingResolution(TypedDict):
+    attempt_ref: str
+    receipt_ref: Optional[str]
+    status: str
+    pending_id: str
+    durable: bool
+    cleanup_qualified: bool
+
+
+class PendingMemoryOutcome(TypedDict, total=False):
+    success: bool
+    error: str
+    native_resolution: NativePendingResolution
+    pending_removed: Optional[bool]
+    cleanup_error: str
+    native_pending: bool
+
+
+def _pending_resolution(attempt_ref, receipt_ref, status, pending_id, operation) -> NativePendingResolution:
+    """Project original owner facts; cleanup eligibility stays in this source owner."""
+    durable = receipt_ref is not None and status != "unknown"
+    return NativePendingResolution(attempt_ref=attempt_ref, receipt_ref=receipt_ref, status=status,
+        pending_id=pending_id, durable=durable, cleanup_qualified=durable and
+        status in {"committed", "unchanged", "rejected"} and (operation != "reject" or status == "rejected"))
+
+
+def current_memory_attempt():
+    return _current_attempt.get()
+
+
+def memory_run_identity(agent):
+    """Native host identity; model arguments never choose the fixed API scope."""
+    session_id = getattr(agent, "_paios_tool_conversation", None) or getattr(agent, "session_id", "") or ""
+    run_id = get_api_run_id(session_id)
+    tool_conversation = getattr(agent, "_paios_tool_conversation", None)
+    if run_id and tool_conversation:
+        # Authenticated isolated transcripts retain their admitted tool scope; memory writes are off.
+        return run_id, tool_conversation
+    if not hasattr(agent, "_memory_effect_db"):
+        return run_id, session_id
+    db = agent._memory_effect_db
+    if run_id and db is not None:
+        try:
+            if Path(db.db_path).parent.resolve() != get_hermes_home().resolve():
+                raise ValueError("native memory host profile binding mismatch")
+            return run_id, db.memory_effect_session(run_id, session_id)
+        except Exception:
+            logger.exception("Native memory host transcript binding unavailable")
+    agent._memory_effect_incomplete = True
+    return "", ""
+
+
+def outcome_status(result):
+    if result.get("staged") and result.get("success"):
+        return "pending_approval"
+    if result.get("rejected"):
+        return "rejected"
+    if not result.get("success"):
+        return "failed"
+    return "committed" if result.get("changed") is True else "unchanged" if result.get("changed") is False else None
+
+
+def execute_memory_effect(agent, args, tool_call_id, invoke):
+    db = getattr(agent, "_memory_effect_db", None)
+    run_id, session_id = memory_run_identity(agent)
+    if not hasattr(agent, "_memory_effect_db"):  # Uninstrumented hosts keep native behavior.
+        return invoke()
+    if not run_id or not db or not tool_call_id:
+        agent._memory_effect_incomplete = True
+        return json.dumps({"success": False, "error": "Native memory outcome source unavailable; no write attempted."})
+    identity = {"run_id": run_id, "session_id": session_id, "tool_call_id": tool_call_id,
+                "profile_home": str(Path(db.db_path).parent.resolve())}
+    operation = "batch" if args.get("operations") else args.get("action") or "invalid"
+    try:
+        identity["attempt_ref"] = db.begin_memory_effect(run_id, session_id, tool_call_id,
+                                                        operation, args.get("target") or "memory",
+                                                        active_session_id=agent.session_id)
+    except Exception:
+        agent._memory_effect_incomplete = True
+        logger.exception("Native memory attempt persistence failed; no write attempted")
+        return json.dumps({"success": False, "error": "Native memory attempt persistence failed; no write attempted."})
+    token = _current_attempt.set(identity)
+    try:
+        stored = db.memory_effect_write_policy(run_id, session_id)
+        bound = current_api_memory_write()
+        matched = bound is not None and bound == (run_id, session_id, stored)
+        allowed = (stored is not False and api_memory_write_allowed(run_id, session_id)
+                   and (matched or stored is None and not memory_write_policy_required()))
+        result = (invoke() if allowed else json.dumps({"success": False, "rejected": True,
+                    "error": "This native run has no memory write permission; memory is unchanged."}))
+        decoded = json.loads(result) if isinstance(result, str) else result
+    except Exception:
+        # A file write exception may occur after replacement; never guess rollback.
+        logger.exception("Native memory attempt did not produce a definitive result")
+        raise
+    finally:
+        _current_attempt.reset(token)
+    status = outcome_status(decoded)
+    if status:
+        try:
+            db.settle_memory_effect(identity["attempt_ref"], status, decoded.get("pending_id"))
+        except Exception:
+            # Preserve a real file commit: receipt loss is an attribution gap, not write failure.
+            logger.exception("Native memory settlement persistence failed; reconciliation required")
+    return result
+
+
+def resolve_pending_memory(record, invoke, *, reject=False) -> PendingMemoryOutcome:
+    identity = record.get("memory_effect")
+    if not isinstance(identity, dict):
+        if "memory_effect" in record or str(record.get("id", "")).startswith("me-"):
+            return {"success": False, "error": "Native pending memory attribution is missing; no write attempted."}
+        return invoke()  # Legacy/CLI-only pending record has no trusted run coverage.
+    if identity.get("profile_home") != str(get_hermes_home().resolve()):
+        return {"success": False, "error": "Pending memory profile binding mismatch."}
+    from hermes_state import SessionDB
+    db = SessionDB(get_hermes_home() / "state.db")
+    try:
+        original, successors = _pending_memory_receipts(db, record)
+        # The caller holds the original pending lock. Never replay an existing attempt.
+        call_id = original["tool_call_id"] + ":resolve:" + record["id"]
+        if successors:
+            prior = successors[0]
+            return {"success": False, "error": "Pending memory resolution already attempted; use /memory reconcile.",
+                    "native_resolution": _pending_resolution(prior["attempt_ref"],
+                        prior["receipt_ref"] if prior["status"] != "unknown" else None,
+                        prior["status"], record["id"], prior["operation"])}
+        if not reject:
+            stored = db.memory_effect_write_policy(original["run_id"], original["session_id"])
+            bound = current_api_memory_write()
+            if (stored is False
+                    or stored is None and memory_write_policy_required()
+                    or bound is not None and not api_memory_write_allowed(original["run_id"], original["session_id"])):
+                return {"success": False, "error": "Pending native memory write permission denied; no write attempted."}
+        ref = db.begin_memory_effect(original["run_id"], original["session_id"], call_id,
+                                     "reject" if reject else original["operation"], original["target"],
+                                     predecessor_ref=original["receipt_ref"], pending_id=record["id"])
+        token = _current_attempt.set({"run_id": original["run_id"], "session_id": original["session_id"],
+                                      "approved_pending": not reject})
+        try:
+            result = dict(invoke())
+        finally:
+            _current_attempt.reset(token)
+        operation = "reject" if reject else original["operation"]
+        result["native_resolution"] = _pending_resolution(ref, None, "unknown", record["id"], operation)
+        status = "rejected" if reject and result.get("success") else outcome_status(result)
+        if status:
+            try:
+                receipt = db.settle_memory_effect(ref, status, record["id"])
+                result["native_resolution"] = _pending_resolution(ref, receipt, status, record["id"], operation)
+            except Exception:
+                result["error"] = "Native settlement unavailable; outcome unknown; pending retained."
+                logger.exception("Pending memory settlement persistence failed; reconciliation required")
+        return result
+    except ValueError as error:
+        return {"success": False, "error": str(error)}
+    finally:
+        db.close()
+
+
+def _pending_memory_receipts(db, record):
+    """Read original/successor facts from the existing SessionDB domain authority."""
+    identity = record.get("memory_effect")
+    if not isinstance(identity, dict):
+        raise ValueError("No native pending attribution; legacy pending needs normal approve/reject.")
+    source = db.read_memory_effects(identity.get("run_id"), identity.get("session_id"))["memory_receipt_source"]
+    facts = [receipt["summary"] for receipt in source["receipts"]] + source["unsettled_attempts"]
+    original = next((fact for fact in facts if fact["attempt_ref"] == identity.get("attempt_ref")), None)
+    payload = record.get("payload") or {}
+    fields = ("profile_home", "run_id", "session_id", "tool_call_id")
+    if (not original or any(identity.get(key) != original[key] for key in fields)
+            or original["profile_home"] != str(get_hermes_home().resolve())
+            or record.get("subsystem") != "memory" or original["status"] != "pending_approval"
+            or original["pending_id"] != record.get("id")
+            or original["operation"] != payload.get("action")
+            or original["target"] != (payload.get("target") or "memory")):
+        raise ValueError("Pending memory attribution unresolved or mismatched; no write attempted.")
+    call_id = original["tool_call_id"] + ":resolve:" + record["id"]
+    successors = [fact for fact in facts if fact["predecessor_ref"] == original["receipt_ref"] or fact["tool_call_id"] == call_id]
+    if len(successors) > 1 or any(
+            fact["tool_call_id"] != call_id or fact["predecessor_ref"] != original["receipt_ref"]
+            or fact["pending_id"] != record["id"] or fact["operation"] not in (original["operation"], "reject")
+            or any(fact[key] != original[key] for key in ("profile_home", "run_id", "session_id", "target"))
+            for fact in successors):
+        raise ValueError("Pending memory successor binding mismatch; no write attempted.")
+    return original, successors
+
+
+def reconcile_pending_memory(record) -> PendingMemoryOutcome:
+    """Caller holds the original pending lock. Cleanup only; never invoke a writer."""
+    if not isinstance(record.get("memory_effect"), dict):
+        return {"success": False, "error": "No native pending attribution; legacy pending needs normal approve/reject."}
+    if record["memory_effect"].get("profile_home") != str(get_hermes_home().resolve()):
+        return {"success": False, "error": "Pending memory profile binding mismatch."}
+    from hermes_state import SessionDB
+    from tools import write_approval as wa
+    db = SessionDB(get_hermes_home() / "state.db")
+    result: PendingMemoryOutcome = {"success": False, "pending_removed": None}
+    try:
+        _, successors = _pending_memory_receipts(db, record)
+        if not successors:
+            return {"success": False, "error": "Native resolution is unknown or not cleanup-qualified; pending retained."}
+        successor = successors[0]
+        resolution = _pending_resolution(successor["attempt_ref"],
+            successor["receipt_ref"] if successor["status"] != "unknown" else None,
+            successor["status"], record["id"], successor["operation"])
+        result["native_resolution"] = resolution
+        if not resolution["cleanup_qualified"]:
+            result["error"] = "Native resolution is unknown or not cleanup-qualified; pending retained."
+            return result
+        removed = wa.discard_pending(wa.MEMORY, record["id"])
+        result.update(success=removed, pending_removed=removed)
+        return result
+    except Exception as error:
+        result["error"] = str(error)
+        return result
+    finally:
+        db.close()
