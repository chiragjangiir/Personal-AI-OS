+def test_identity_resolver_query_errors_propagate_without_default_history_fallback(native_scope, monkeypatch, statement):
+    db, agent = native_scope
+    read_ctx = db._read_ctx
+    class Fault:
+        def __init__(self, conn):
+            self.conn = conn
+        def execute(self, sql, *args):
+            if statement in sql:
+                raise sqlite3.OperationalError("synthetic lineage query failure")
+            return self.conn.execute(sql, *args)
+    @contextmanager
+    def faulted_read():
+        with read_ctx() as conn:
+            yield Fault(conn)
+    monkeypatch.setattr(db, "_read_ctx", faulted_read)
+    # Existing default history behavior remains; strict identity uses the explicit connection.
+    assert db.resolve_resume_session_id("admitted-parent") == "admitted-parent"
+    with pytest.raises(sqlite3.OperationalError, match="synthetic lineage query failure"):
+        db.memory_effect_session("logical-run", "admitted-parent")
+    assert not db._conn.in_transaction
+    assert dispatch_memory_provider_tool(agent, "source-consumer", {}, "broken-proof")["run_id"] == ""
+    assert db._read_all("SELECT * FROM memory_effect_attempts") == []
+    resolve = db.resolve_resume_session_id
+    monkeypatch.setattr(db, "resolve_resume_session_id", lambda scope, *, _conn=None: resolve(scope, _conn=Fault(_conn)))
+    with pytest.raises(sqlite3.OperationalError, match="synthetic lineage query failure"):
+        db.begin_memory_effect("logical-run", "admitted-parent", "broken-transaction", "add", "memory",
+                              active_session_id="admitted-parent")
