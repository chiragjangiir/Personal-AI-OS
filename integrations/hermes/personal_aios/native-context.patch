+def peer_publish(db, parent, child):
+    # A separate process uses the real SessionDB transaction. No fabricated alias/id mutation.
+    script = '''from hermes_state import SessionDB
+import sys
+from pathlib import Path
+with_db=SessionDB(Path(sys.argv[1]))
+try:
+ with_db.publish_compression_child(parent_session_id=sys.argv[2],child_session_id=sys.argv[3],
+  source='api_server',messages=[{'role':'user','content':'peer durable compressed handoff'}],
+  require_compression_lease=False)
+finally:with_db.close()
+'''
+    child_process = subprocess.run([sys.executable,'-B','-c',script,str(db.db_path),parent,child],
+        capture_output=True,text=True,timeout=15)
+    assert child_process.returncode == 0, child_process.stderr
+
