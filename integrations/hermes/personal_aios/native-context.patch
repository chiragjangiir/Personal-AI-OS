+    assert 'reconciled committed' in handle_pending_subcommand('memory',['reconcile',record['id']])
+
+
+def test_source_typed_outcome_keeps_receipt_identity_and_removal_distinct(pending):
+    home,db,record,predecessor=pending
+    result=outcomes.resolve_pending_memory(record,lambda:{'success':True},reject=True)
+    decision=result['native_resolution']
+    assert decision['status']=='rejected' and decision['durable'] and decision['cleanup_qualified']
+    row=db._read_one('SELECT * FROM memory_effect_settlements WHERE attempt_ref=?',(decision['attempt_ref'],))
+    assert row['receipt_ref']==decision['receipt_ref'] and row['pending_id']==decision['pending_id']==record['id']
+    assert 'pending_removed' not in result and wa.get_pending('memory',record['id'])
