@@ -0,0 +1,100 @@
+"""External contract changes must survive resume without rewriting core pinned bytes."""
+import copy
+import json
+import types
+from pathlib import Path
+
+import httpx
+import pytest
+from openai import OpenAI
+from openai._models import FinalRequestOptions
+from agent.memory_manager import MemoryManager
+from agent.transports.chat_completions import ChatCompletionsTransport
+from hermes_state import SessionDB
+from tools import mcp_tool_agent as owner
+from tools import registry as registry_mod
+
+
+def tool(name, description):
+    return {"type": "function", "function": {"name": name, "description": description,
+        "parameters": {"type": "object", "properties": {"continuity_ref": {
+            "type": "string", "description": description}}, "required": []}}}
+
+
+def agent(monkeypatch, definitions, provider_schemas):
+    manager = MemoryManager()
+    manager.add_provider(types.SimpleNamespace(name="private-external",
+        get_tool_schemas=lambda: copy.deepcopy(provider_schemas)))
+    monkeypatch.setattr(owner, "tool_pin_version", lambda: "same-code")
+    monkeypatch.setattr(registry_mod.registry, "get_all_entries", lambda: [types.SimpleNamespace(name="read_file")])
+    return types.SimpleNamespace(tools=copy.deepcopy(definitions), _memory_manager=manager,
+        valid_tool_names={t["function"]["name"] for t in definitions}, enabled_toolsets=None,
+        disabled_toolsets=None, side_agent=False, _session_db=None)
+
+
+@pytest.mark.parametrize("case", ["changed", "unchanged", "removed", "disabled", "other-code", "legacy", "no-manager", "no-provider"])
+def test_external_current_contract_and_core_prefix_have_distinct_owners(monkeypatch, case):
+    old_core, fresh_core = tool("read_file", "pinned core"), tool("read_file", "fresh core")
+    old, fresh = tool("paios_open_reply", "old"), tool("paios_open_reply", "exact current D copy or omit")
+    if case == "unchanged": fresh = copy.deepcopy(old)
+    schemas = [fresh["function"], fresh_core["function"]] if case != "removed" else []
+    definitions = [fresh_core] if case in {"removed", "disabled"} else [fresh_core, fresh]
+    a = agent(monkeypatch, definitions, schemas)
+    if case == "no-manager": del a._memory_manager
+    if case == "no-provider": a._memory_manager = MemoryManager()
+    repins = []
+    monkeypatch.setattr(owner, "persist_agent_tool_names", lambda current: repins.append(copy.deepcopy(current.tools)))
+    if hasattr(a, "_memory_manager"):
+        a._memory_manager.get_all_tool_schemas = lambda: pytest.fail("restore must not fetch provider schemas")
+    assert "read_file" not in getattr(a, "_memory_manager", MemoryManager()).get_all_tool_names()  # real reserved-name authority
+    saved = {"version": "other-code" if case == "other-code" else "same-code", "tools": [old, old_core]}
+    if case == "legacy": saved = ["paios_open_reply", "read_file"]
+    original = copy.deepcopy(saved)
+    owner.restore_agent_tool_prefix(a, saved)
+    expected_core = fresh_core if case in {"other-code", "legacy"} else old_core
+    expected_external = old if case in {"no-manager", "no-provider"} else fresh
+    assert a.tools == ([expected_core] if case in {"removed", "disabled"} else [expected_external, expected_core])
+    assert bool(repins) == (case in {"changed", "removed", "disabled", "other-code", "legacy"})
+    assert saved == original
+    assert a.valid_tool_names == {t["function"]["name"] for t in a.tools}
+
+
+@pytest.mark.parametrize("persist_fails", [False, True])
+def test_official_repin_resume_and_transport_sdk_keep_current_external_contract(monkeypatch, tmp_path, persist_fails):
+    contracts = json.loads((Path(__file__).resolve().parents[1] / "fixtures/personal_aios_tool_contracts.json").read_text())
+    fresh = {"type": "function", "function": next(t for t in contracts if t["name"] == "paios_open_reply")}
+    old = copy.deepcopy(fresh)
+    del old["function"]["parameters"]["properties"]["continuity_ref"]["description"]
+    core = tool("read_file", "stable core")
+    a = agent(monkeypatch, [fresh, core], [fresh["function"]])
+    with SessionDB(db_path=tmp_path / "state.db") as db:
+        db.create_session("isolated-resume", source="test")
+        a._session_db, a.session_id, a.tools = db, "isolated-resume", [old, core]
+        owner.persist_agent_tool_names(a)
+        old_pin = db.get_session(a.session_id)["tool_names"]
+        a.tools = [fresh, core]
+        original_pin = copy.deepcopy(json.loads(old_pin))
+        if persist_fails:
+            monkeypatch.setattr(db, "update_session_tool_names", lambda *args: (_ for _ in ()).throw(OSError("controlled persist failure")))
+        from agent.conversation_loop import _restore_pinned_tools
+        _restore_pinned_tools(a, {"tool_names": old_pin})
+        assert a.tools == [fresh, core]
+        assert original_pin == json.loads(old_pin)
+        stored = json.loads(db.get_session(a.session_id)["tool_names"])
+        assert stored["tools"] == ([old, core] if persist_fails else [fresh, core])
+        # A second fresh agent reuses current schema even if the first persistence failed.
+        resumed = agent(monkeypatch, [fresh, core], [fresh["function"]])
+        owner.restore_agent_tool_prefix(resumed, stored)
+        assert resumed.tools == [fresh, core]
+        kwargs = ChatCompletionsTransport().build_kwargs(model="mimo-v2.6-pro",
+            messages=[{"role": "user", "content": "synthetic transport fixture"}], tools=resumed.tools,
+            max_tokens=2048, is_custom_provider=True, base_url="https://api.xiaomimimo.com/v1")
+        def deny_send(request):
+            pytest.fail("HTTP send is outside this test")
+        with OpenAI(api_key="synthetic-test-only", base_url="https://api.xiaomimimo.com/v1",
+                    http_client=httpx.Client(transport=httpx.MockTransport(deny_send))) as client:
+            request = client._build_request(FinalRequestOptions.construct(
+                method="post", url="/chat/completions", json_data=kwargs))
+            body = json.loads(request.content)
+        assert body["tools"] == [fresh, core]
+        assert body["tools"][0]["function"]["parameters"]["properties"]["continuity_ref"]["description"] == fresh["function"]["parameters"]["properties"]["continuity_ref"]["description"]
