index 0000000000000000000000000000000000000000..d241d526921f3200fe8bb9d3c6e77fd0bedc0f62
--- /dev/null
+++ b/agent/final_response_evidence.py
@@ -0,0 +1,71 @@
+"""Read-only evidence for the ordinary final assistant row; never a history writer."""
+from hashlib import sha256
+
+SCHEMA = "hermes.final-response.v1"
+
+def mark_final_response(agent, message, messages, *, promoted, finish_reason):
+    from gateway.session_context import get_api_run_id
+    run_id = get_api_run_id(agent.session_id or "")
+    turn_id = getattr(agent, "_current_turn_id", "")
+    if not run_id or not turn_id or promoted or finish_reason != "stop":
+        return
+    after_tool = after_name = None
+    for row in reversed(messages):
+        if row.get("role") == "user":
+            break
+        if row.get("role") == "tool":
+            after_tool = row.get("tool_call_id")
+            after_name = row.get("tool_name")
+            break
+    message["display_metadata"] = {**(message.get("display_metadata") or {}),
+        "native_final_response": {"schema": SCHEMA, "run_id": run_id,
+            "turn_id": turn_id, "after_tool_call_id": after_tool, "after_tool_name": after_name, "phase": "final_buffer"}}
+
+def final_boundary(db, proof):
+    params = (proof["session_id"], proof["message_id"])
+    previous = db._read_one("SELECT id, role FROM messages WHERE session_id=? AND id<? ORDER BY id DESC LIMIT 1", params)
+    tool = db._read_one("SELECT id FROM messages WHERE session_id=? AND id<? AND role='tool' ORDER BY id DESC LIMIT 1", params)
+    return {"previous_message_id": previous[0] if previous else None,
+        "previous_message_role": previous[1] if previous else None,
+        "last_tool_message_id": tool[0] if tool else None}
+
+def verify_final_response(db, proof, output):
+    if not isinstance(proof, dict) or proof.get("schema") != SCHEMA or proof.get("phase") != "final_buffer":
+        return False
+    row_id = proof.get("message_id")
+    if type(row_id) is not int or row_id <= 0 or not isinstance(output, str):
+        return False
+    rows = db.get_messages(proof["session_id"], include_inactive=True, after_id=row_id - 1, limit=1)
+    if not rows or rows[0].get("id") != row_id:
+        return False
+    row = rows[0]
+    boundary = final_boundary(db, proof)
+    if any(proof.get(key) != value for key, value in boundary.items()):
+        return False
+    if proof.get("after_tool_call_id") is not None:
+        tool = db._read_one("SELECT tool_call_id, tool_name FROM messages WHERE session_id=? AND id=? AND role='tool'",
+            (proof["session_id"], proof.get("last_tool_message_id")))
+        if not tool or tool[0] != proof["after_tool_call_id"] or tool[1] != proof.get("after_tool_name"):
+            return False
+    meta = (row.get("display_metadata") or {}).get("native_final_response")
+    expected = {key: proof.get(key) for key in ("schema", "run_id", "turn_id", "after_tool_call_id", "after_tool_name", "phase")}
+    return (row.get("role") == "assistant" and not row.get("tool_calls")
+        and row.get("finish_reason") == "stop" and row.get("content") == output
+        and meta == expected and proof.get("sha256") == sha256(output.encode("utf-8")).hexdigest())
+
+def final_response_evidence(agent, messages, result):
+    if (result.get("failed") or result.get("interrupted")
+        or result.get("pending_steer") or not messages):
+        return None
+    row = messages[-1]
+    meta = (row.get("display_metadata") or {}).get("native_final_response")
+    output = result.get("final_response")
+    if not isinstance(meta, dict) or meta.get("turn_id") != getattr(agent, "_current_turn_id", None) or not isinstance(output, str):
+        return None
+    proof = {**meta, "session_id": agent.session_id, "message_id": row.get("_row_id"),
+        "sha256": sha256(output.encode("utf-8")).hexdigest()}
+    try:
+        proof.update(final_boundary(agent._session_db, proof))
+        return proof if verify_final_response(agent._session_db, proof, output) else None
+    except Exception:
+        return None
