+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from agent.inline_tool_executors import InlineToolContext, _memory
+from gateway.session_context import clear_session_vars, get_api_run_id, set_session_vars
+from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+from hermes_state import SessionDB
+from tools.memory_tool import MemoryStore
+from tools import write_approval as wa
+from hermes_cli.write_approval_commands import handle_pending_subcommand
+
+
+def make_agent(home, run):
+    home.mkdir(exist_ok=True)
+    db = SessionDB(home / "state.db")
+    db.begin_memory_effect_run(run, "session")
+    store = MemoryStore(); store.load_from_disk()
+    return SimpleNamespace(_memory_effect_db=db, session_id="session",
+                           _memory_store=store, _memory_manager=None)
+
+
+def call(agent, call_id, **args):
+    return json.loads(_memory(agent, args, InlineToolContext("session", call_id)))
+
+
+def test_real_memory_results_profile_scope_pending_and_process_read(tmp_path, monkeypatch):
+    agents = {}
+    monkeypatch.setattr(wa, "write_approval_enabled", lambda _: False)
+    for index, profile in enumerate(("A", "B", "A")):
+        token = set_hermes_home_override(tmp_path / profile)
+        session_tokens = set_session_vars(platform="api_server", session_id="session", session_key="run-" + profile)
+        try:
+            if profile not in agents:
+                agents[profile] = make_agent(tmp_path / profile, "run-" + profile)
+            agent = agents[profile]
+            if index < 2:
+                assert call(agent, "add", action="add", content=profile)["changed"] is True
+            else:
+                assert call(agent, "duplicate", action="add", content="A")["changed"] is False
+                assert call(agent, "replace", action="replace", old_text="A", content="A-new")["changed"] is True
+                assert call(agent, "same", action="replace", old_text="A-new", content="A-new")["changed"] is False
+                assert not call(agent, "bad-batch", operations=[{"action": "add", "content": "bad"},
+                                                                {"action": "remove", "old_text": "missing"}])["success"]
+                assert agent._memory_store.memory_entries == ["A-new"]
+                assert call(agent, "batch", operations=[{"action": "add", "content": "A-more"},
+                                                        {"action": "remove", "old_text": "A-new"}])["changed"]
+                assert call(agent, "remove", action="remove", old_text="A-more")["changed"]
+                monkeypatch.setattr(wa, "evaluate_gate", lambda *a, **k: wa.GateDecision(stage=True))
+                staged = call(agent, "stage", action="add", content="approved")
+                stage_ref = agent._memory_effect_db.read_memory_effects("run-A")["memory_receipt_source"]["receipts"][-1]["receipt_ref"]
+                pending = wa.get_pending("memory", staged["pending_id"])
+                assert pending["memory_effect"]["tool_call_id"] == "stage"
+                from tools.memory_tool_outcomes import resolve_pending_memory
+                attempted = []
+                foreign = set_hermes_home_override(tmp_path / "B")
+                try:
+                    before_b = (tmp_path / "B" / "memories" / "MEMORY.md").read_bytes()
+                    assert not resolve_pending_memory(pending, lambda: attempted.append(True))["success"]
+                    assert (tmp_path / "B" / "memories" / "MEMORY.md").read_bytes() == before_b
+                    assert not (tmp_path / "B" / "pending").exists()
+                    assert not attempted
+                finally:
+                    reset_hermes_home_override(foreign)
+                agent._memory_effect_db.begin_memory_effect_run("foreign-run", "foreign-session")
+                for key, value in (("run_id", "foreign-run"), ("session_id", "foreign-session"),
+                                   ("tool_call_id", "foreign-call"), ("attempt_ref", "absent")):
+                    tampered = copy.deepcopy(pending); tampered["memory_effect"][key] = value
+                    assert not resolve_pending_memory(tampered, lambda: attempted.append(True))["success"]
+                tampered = copy.deepcopy(pending); tampered["id"] = "different-pending"
+                assert not resolve_pending_memory(tampered, lambda: attempted.append(True))["success"]
+                tampered = copy.deepcopy(pending); del tampered["memory_effect"]["session_id"]
