diff --git a/tests/agent/test_custom_provider_output_budget.py b/tests/agent/test_custom_provider_output_budget.py
new file mode 100644
index 0000000000000000000000000000000000000000..8f0e9a062ae67d74db5d0c4432572614c1546c08
--- /dev/null
+++ b/tests/agent/test_custom_provider_output_budget.py
@@ -0,0 +1,224 @@
+"""Custom defaults share Hermes' native output budget through SDK serialization."""
+
+import json
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import httpx
+import pytest
+from openai import OpenAI
+from providers import get_provider_profile
+
+from agent.agent_init import _merge_custom_provider_extra_body
+from agent.agent_runtime_helpers import _apply_primary_runtime_fields, _apply_switched_provider_request_overrides
+from agent.chat_completion_helpers import _consume_ephemeral_max_output, _rescope_fallback_extra_body
+from agent.transports import get_transport
+from agent.transports import chat_completions  # noqa: F401
+from agent.turn_iteration_prep import apply_retry_restarts
+from agent.turn_retry_state import TurnRetryState
+from run_agent import AIAgent
+
+
+PROVIDER = {
+    "provider_key": "local-test", "base_url": "https://provider.test/v1", "model": "test-model",
+    "extra_body": {"max_tokens": 2048, "temperature": 0, "enable_thinking": False, "reasoning_effort": "none"},
+}
+
+
+def _agent(max_tokens=None, overrides=None):
+    return SimpleNamespace(
+        provider="custom:local-test", model="test-model", base_url=PROVIDER["base_url"],
+        max_tokens=max_tokens, request_overrides=overrides or {}, _custom_providers=[PROVIDER],
+        _ephemeral_max_output_tokens=None,
+        _requested_output_cap_from_api_kwargs=AIAgent._requested_output_cap_from_api_kwargs,
+    )
+
+
+def _wire(agent, *, profile=None, reasoning_config=None):
+    """Exercise the real OpenAI SDK's extra_body merge with no network or credential."""
+    kwargs = get_transport("chat_completions").build_kwargs(
+        model=agent.model, messages=[{"role": "user", "content": "synthetic"}], tools=None,
+        max_tokens=agent.max_tokens, ephemeral_max_output_tokens=_consume_ephemeral_max_output(agent),
+        max_tokens_param_fn=lambda cap: {"max_tokens": cap}, request_overrides=agent.request_overrides,
+        provider_profile=profile, reasoning_config=reasoning_config,
+    )
+    captured = []
+
+    def respond(request):
+        captured.append(json.loads(request.content))
+        return httpx.Response(200, json={
+            "id": "test", "object": "chat.completion", "created": 0, "model": "test-model",
+            "choices": [{"index": 0, "finish_reason": "stop", "message": {"role": "assistant", "content": "ok"}}],
+        })
+
+    with OpenAI(api_key="synthetic", base_url="https://provider.test/v1", http_client=httpx.Client(
+        transport=httpx.MockTransport(respond),
+    )) as client:
+        client.chat.completions.create(**kwargs)
+    assert "max_tokens" not in (kwargs.get("extra_body") or {})
+    return captured[0]
+
+
+@pytest.mark.parametrize("profile", [None, get_provider_profile("custom")])
+def test_initial_sdk_budget_and_nonbudget_provider_fields_are_preserved(profile):
+    agent = _agent()
+    _merge_custom_provider_extra_body(agent, [PROVIDER])
+    assert agent.max_tokens == 2048
+    assert agent._custom_provider_max_tokens == 2048
+    wire = _wire(agent, profile=profile)
+    assert wire["max_tokens"] == 2048
+    assert wire["temperature"] == 0
+    assert wire["enable_thinking"] is False
+    assert wire["reasoning_effort"] == "none"
+    assert PROVIDER["extra_body"]["max_tokens"] == 2048  # configuration is immutable
+
+
+@pytest.mark.parametrize("overrides", [{"max_tokens": 2048}, {"extra_body": {"max_tokens": 2048}}])
+def test_custom_caller_budget_without_provider_extra_uses_native_recovery(overrides):
+    agent = _agent(overrides=overrides)
+    _merge_custom_provider_extra_body(agent, [])
+    assert _wire(agent)["max_tokens"] == 2048
+    agent._ephemeral_max_output_tokens = 8192
+    assert _wire(agent)["max_tokens"] == 8192
+
+
+def test_noncustom_caller_override_is_outside_custom_normalization_scope():
+    agent = _agent(overrides={"extra_body": {"max_tokens": 2048}})
+    agent.provider = "openai"
+    _merge_custom_provider_extra_body(agent, [])
+    assert agent.max_tokens is None
+    assert agent.request_overrides == {"extra_body": {"max_tokens": 2048}}
+
+
+@pytest.mark.parametrize("constructor, overrides, expected", [
+    (6000, {}, 6000),
+    (6000, {"extra_body": {"max_tokens": 7000, "caller_only": 1}}, 7000),
+    (6000, {"max_tokens": 9000, "extra_body": {"max_tokens": 7000}}, 9000),
+])
+def test_explicit_cap_precedence_and_one_shot_recovery(constructor, overrides, expected):
+    agent = _agent(constructor, overrides)
+    agent._session_init_model_config = {"max_tokens": constructor}
+    _merge_custom_provider_extra_body(agent, [PROVIDER])
+    assert _wire(agent)["max_tokens"] == expected
+    for boost in (8192, 16384):
+        agent._ephemeral_max_output_tokens = boost
+        assert _wire(agent)["max_tokens"] == boost
+        assert agent._ephemeral_max_output_tokens is None
+    assert _wire(agent)["max_tokens"] == expected  # final/next ordinary request returns to baseline
+    assert agent._session_init_model_config["max_tokens"] == expected
+    if "caller_only" in overrides.get("extra_body", {}):
+        assert agent.request_overrides["extra_body"]["caller_only"] == 1
+
+
+@pytest.mark.parametrize("invalid", [True, False, 0, -1, 1.5, "2048"])
+@pytest.mark.parametrize("location", ["provider", "request", "request_extra"])
+def test_invalid_budget_rejected_before_request_without_mutation(invalid, location):
+    entry = {**PROVIDER, "extra_body": dict(PROVIDER["extra_body"])}
+    overrides = {}
+    if location == "provider":
+        entry["extra_body"]["max_tokens"] = invalid
+    elif location == "request":
+        overrides["max_tokens"] = invalid
+    else:
+        overrides["extra_body"] = {"max_tokens": invalid}
+    agent = _agent(overrides=overrides)
+    with pytest.raises(ValueError, match="positive integer"):
+        _merge_custom_provider_extra_body(agent, [entry])
+    assert agent.max_tokens is None
+    assert agent.request_overrides == overrides
+
+
+def test_custom_budget_is_route_scoped_for_switch_fallback_and_restore():
+    agent = _agent()
+    _merge_custom_provider_extra_body(agent, [PROVIDER])
+    original_overrides = dict(agent.request_overrides)
+    agent.provider, agent.model, agent.base_url = "custom:other", "other-model", "https://other.test/v1"
+    other = {"provider_key": "other", "base_url": agent.base_url, "extra_body": {"max_tokens": 5000, "top_k": 20}}
+    agent._custom_providers.append(other)
+    _rescope_fallback_extra_body(agent, PROVIDER["model"], "custom:local-test", PROVIDER["base_url"])
+    assert agent.max_tokens == 5000
+    assert agent.request_overrides == {"extra_body": {"top_k": 20}}
+    agent.context_compressor = MagicMock()
+    _apply_primary_runtime_fields(agent, {
+        "model": PROVIDER["model"], "provider": "custom:local-test", "base_url": PROVIDER["base_url"],
+        "api_mode": "chat_completions", "api_key": "synthetic", "client_kwargs": {},
+        "request_overrides": original_overrides, "max_tokens": 2048, "custom_provider_max_tokens": 2048,
+    })
+    assert agent.max_tokens == agent.context_compressor.max_tokens == 2048
+    agent.model, agent.provider, agent.base_url = "built-in-model", "openai", "https://api.openai.com/v1"
+    _apply_switched_provider_request_overrides(agent, "openai")
+    assert agent.max_tokens is None
+    assert agent._custom_provider_max_tokens is None
+    assert "extra_body" not in agent.request_overrides
+    assert agent.context_compressor.update_model.call_args.kwargs["max_tokens"] == 0
+
+
+def test_explicit_constructor_budget_survives_route_switch():
+    agent = _agent(max_tokens=2048)
+    _merge_custom_provider_extra_body(agent, [PROVIDER])
+    assert agent._custom_provider_max_tokens is None
+    agent.provider, agent.model, agent.base_url = "openai", "other-model", "https://api.openai.com/v1"
+    _apply_switched_provider_request_overrides(agent, "openai")
+    assert agent.max_tokens == 2048
+
+
+def _retry(agent, length_retries, *, continuation):
+    retry = TurnRetryState()
+    retry.restart_with_length_continuation = continuation
+    return apply_retry_restarts(
+        agent, _retry=retry, response=object(), interrupted=False, messages=[], conversation_history=[],
+        user_message="synthetic", api_kwargs={"max_tokens": 2048}, current_turn_user_idx=0,
+        final_response=None, retry_count=0, max_retries=3, api_call_count=1,
+        restart_count=0, length_continue_retries=length_retries,
+        _preflight_compression_blocked=False, _turn_exit_reason="unknown",
+    )
+
+
+def test_native_length_continuation_changes_sdk_cap_and_normal_final_does_not():
+    agent = _agent()
+    _merge_custom_provider_extra_body(agent, [PROVIDER])
+    assert _retry(agent, 0, continuation=False).action == "fallthrough"
+    assert _wire(agent)["max_tokens"] == 2048
+    for n, expected in ((2, 8192), (3, 16384)):
+        assert _retry(agent, n, continuation=True).action == "continue"
+        assert _wire(agent)["max_tokens"] == expected
+    assert _retry(agent, 3, continuation=False).action == "fallthrough"
+    assert _wire(agent)["max_tokens"] == 2048
+
+
+def test_invalid_switched_custom_budget_rolls_back_before_compressor_and_capabilities():
+    from agent.agent_runtime_helpers import switch_model
+    from tests.agent.test_switch_model_rollback import _make_agent_openrouter
+
+    agent = _make_agent_openrouter()
+    agent.max_tokens = 2048
+    agent._custom_provider_max_tokens = None
+    agent.request_overrides = {"extra_body": {"caller_only": "retained"}}
+    agent._custom_providers = []
+    agent.context_compressor = MagicMock()
+    agent.context_compressor.max_tokens = 2048
+    original = {
+        key: getattr(agent, key) for key in ("model", "provider", "base_url", "client", "max_tokens",
+                                           "request_overrides", "runtime_capabilities", "_primary_runtime", "_custom_providers")
+    }
+    agent._create_openai_client = MagicMock(return_value=MagicMock())
+    invalid = {**PROVIDER, "extra_body": {"max_tokens": False}}
+    with (
+        patch("agent.agent_runtime_helpers._resolve_switch_context_length", return_value=([invalid], 100000)),
+        patch("hermes_cli.timeouts.get_provider_request_timeout", return_value=None),
+    ):
+        with pytest.raises(ValueError, match="positive integer"):
+            switch_model(agent, PROVIDER["model"], "custom:local-test", api_key="synthetic",
+                         base_url=PROVIDER["base_url"], api_mode="chat_completions")
+    for key, value in original.items():
+        assert getattr(agent, key) == value
+    assert agent.context_compressor.max_tokens == 2048
+    agent.context_compressor.update_model.assert_not_called()
+
+
+@pytest.mark.parametrize("profile", [None, get_provider_profile("custom")])
+def test_explicit_turn_reasoning_disable_overrides_provider_thinking_default(profile):
+    agent = _agent(overrides={"extra_body": {"thinking": {"type": "enabled"}}})
+    assert _wire(agent, profile=profile)["thinking"] == {"type": "enabled"}
+    assert _wire(agent, profile=profile, reasoning_config={"enabled": False})["thinking"] == {"type": "disabled"}
+    assert agent.request_overrides["extra_body"]["thinking"] == {"type": "enabled"}
