+    with patch.object(SessionDB,'read_memory_effects',side_effect=OSError('controlled read unavailable')):
+        assert 'retained' in handle_pending_subcommand('memory',['reconcile',record['id']])
+    assert wa.get_pending('memory',record['id'])
+
+
+def test_reader_close_failure_does_not_claim_deleted_pending_is_retained(pending):
