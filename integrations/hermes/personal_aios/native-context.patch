+    assert wa.get_pending('memory',legacy['id']);assert not wa.get_pending('memory',record['id'])
+    assert handle_pending_subcommand('skills',['reconcile','all']) is None
+
+def test_discard_failure_preserves_settlement_and_can_retry(pending):
