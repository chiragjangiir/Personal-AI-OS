+    with patch.object(wa,'discard_pending',return_value=False):
+        assert 'retained' in handle_pending_subcommand('memory',['reconcile',record['id']])
+    assert wa.get_pending('memory',record['id'])
+    assert 'reconciled committed' in handle_pending_subcommand('memory',['reconcile',record['id']])
+
+def test_database_read_failure_retains_pending(pending):
