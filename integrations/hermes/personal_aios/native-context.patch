+@pytest.mark.skipif(os.getenv("HERMES_TEST_WORKSHOP_SCOPE") != "1", reason="requires trusted workshop image")
+@requires_ssh
+@pytest.mark.parametrize("detach", ["setsid", "doublefork"])
+def test_workshop_cleanup_kills_detached_descendants(monkeypatch, detach):
+    """Reviewer M2: a detached old job must not mutate storage after its lease ends."""
+    import uuid
+    from gateway import run_scope
+
+    monkeypatch.setattr(run_scope, "current_scope", lambda: "build")
+    monkeypatch.setattr("hermes_cli.config.load_config", lambda: {"terminal": {"ssh_isolated": True}})
+    probe = f"/workshop/scope-regression-{uuid.uuid4().hex}"
+    kwargs = dict(host=_SSH_HOST, user=_SSH_USER, port=_SSH_PORT, key_path=_SSH_KEY, cwd="/workshop")
+    first = SSHEnvironment(**kwargs)
+    second = None
+    code = f"""import os,pathlib,time
+root=pathlib.Path({probe!r})
+if os.fork(): os._exit(0)
+os.setsid()
+if {detach == 'doublefork'!r} and os.fork(): os._exit(0)
+(root/'ready').write_text('ready')
+end=time.monotonic()+20
+while time.monotonic()<end:
+ if (root/'trigger').exists():
+  (root/'survived').write_text('old detached job survived')
+  break
+ time.sleep(.02)
+"""
+    try:
+        setup = f"mkdir -m 777 {probe}; python3 -c {shlex.quote(code)} </dev/null >/dev/null 2>&1"
+        assert first.execute(setup)["returncode"] == 0
+        assert first.execute(f"for n in $(seq 1 100); do test -f {probe}/ready && exit 0; sleep .02; done; exit 1")["returncode"] == 0
+        first.cleanup()  # Returns only when trusted namespace PID1 and every descendant are gone.
+        first = None
+        second = SSHEnvironment(**kwargs)
+        result = second.execute(f"touch {probe}/trigger; sleep 1; test ! -e {probe}/survived")
+        assert result["returncode"] == 0, result
+        assert second.execute("grep '^CapBnd:' /proc/self/status")["output"].strip().endswith("0000000000000000")
+    finally:
+        if first is not None:
+            first.cleanup()
+        if second is not None:
+            second.execute(f"rm -rf -- {probe}")
+            second.cleanup()
+
+
+@pytest.mark.parametrize("failure", [False, True])
+def test_isolated_idle_reaper_keeps_lease_visible_until_cleanup_ack(monkeypatch, failure):
+    import threading
+    import time
+    from types import SimpleNamespace
+    from tools import terminal_tool as terminal
+    from tools import terminal_tool_lifecycle as lifecycle
+    from tools.process_registry import process_registry
+
+    entered, release, manual_started, manual_done = (threading.Event() for _ in range(4))
+    errors = []
+
+    def cleanup():
+        entered.set()
+        assert release.wait(5)
+        if failure:
+            raise RuntimeError("namespace did not acknowledge destruction")
+
+    env = SimpleNamespace(isolated=True, cleanup=cleanup)
+    monkeypatch.setattr(terminal, "_active_environments", {"scope": env})
+    monkeypatch.setattr(terminal, "_last_activity", {"scope": time.time() - 1000})
+    monkeypatch.setattr(terminal, "_creation_locks", {})
+    monkeypatch.setattr(terminal, "_resolve_container_task_id", lambda task_id: task_id)
+    monkeypatch.setattr(process_registry, "has_active_processes", lambda task_id: False)
+    monkeypatch.setattr(lifecycle, "_clear_file_ops_cache", lambda task_id: None)
+
+    def run(fn):
+        try:
+            fn()
+        except RuntimeError as exc:
+            errors.append(str(exc))
+
+    def finish_run():
+        manual_started.set()
+        try:
+            lifecycle.cleanup_vm("scope")
+        finally:
+            manual_done.set()
+
+    reaper = threading.Thread(target=run, args=(lifecycle._cleanup_inactive_envs,))
+    finalizer = threading.Thread(target=run, args=(finish_run,))
+    reaper.start()
+    try:
+        assert entered.wait(5)
+        assert lifecycle.get_active_env("scope") is env
+        finalizer.start()
+        assert manual_started.wait(5)
+        assert not manual_done.wait(.05)
+    finally:
+        release.set()
+        reaper.join(5)
+        if finalizer.ident is not None:
+            finalizer.join(5)
+    assert not reaper.is_alive() and not finalizer.is_alive()
+    assert (lifecycle.get_active_env("scope") is env) is failure
+    assert len(errors) == (2 if failure else 0)
+
+
+@pytest.mark.parametrize("failure", [False, True])
+def test_isolated_old_cleanup_preserves_replacement(monkeypatch, failure):
+    import threading
+    from types import SimpleNamespace
+    from tools import terminal_tool as terminal
+    from tools import terminal_tool_lifecycle as lifecycle
+
+    replacement, replacement_lock = object(), threading.Lock()
+
+    def cleanup():
+        # A reset replaces the cache while this old namespace is shutting down.
+        with terminal._env_lock:
+            terminal._active_environments["scope"] = replacement
+            terminal._last_activity["scope"] = 123
+            terminal._creation_locks["scope"] = replacement_lock
+        if failure:
+            raise RuntimeError("old namespace cleanup failed")
+
+    old = SimpleNamespace(isolated=True, cleanup=cleanup)
+    monkeypatch.setattr(terminal, "_active_environments", {"scope": old})
+    monkeypatch.setattr(terminal, "_last_activity", {"scope": 0})
+    monkeypatch.setattr(terminal, "_creation_locks", {})
+    monkeypatch.setattr(terminal, "_resolve_container_task_id", lambda task_id: task_id)
+    if failure:
+        with pytest.raises(RuntimeError, match="old namespace cleanup failed"):
+            lifecycle.cleanup_vm("scope")
+    else:
+        lifecycle.cleanup_vm("scope")
+    assert terminal._active_environments["scope"] is replacement
+    assert terminal._last_activity["scope"] == 123
+    assert terminal._creation_locks["scope"] is replacement_lock
+
