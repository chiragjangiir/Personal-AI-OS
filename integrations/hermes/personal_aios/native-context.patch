@@ -170,6 +170,65 @@ def reset_session_vars() -> None:
     _runtime_cwd("clear_session_cwd")
 
 
+# Per-run API memory permission. None preserves standalone Hermes behavior.
+_API_MEMORY_WRITE = ContextVar("native_api_memory_write", default=None)
+
+
+def memory_write_policy_required() -> bool:
+    from hermes_cli.config import load_config_readonly
+    config = load_config_readonly()
+    return (config.get("memory") or {}).get("provider") == "personal_aios"
+
+
+def api_memory_write_request(body):
+    """Authenticated HTTP owner field; never inspect model input/instructions."""
+    if not isinstance(body, dict):
+        raise ValueError("run request must be a JSON object")
+    if "memory_write" in body and type(body["memory_write"]) is not bool:
+        raise ValueError("memory_write must be boolean")
+    return body.get("memory_write", False if memory_write_policy_required() else None)
+
+
+def bind_api_memory_write(run_id, session_id, permission):
+    if permission is not None and type(permission) is not bool:
+        raise ValueError("invalid native memory permission")
+    return _API_MEMORY_WRITE.set((run_id, session_id, permission))
+
+
+def reset_api_memory_write(token):
+    _API_MEMORY_WRITE.reset(token)
+
+
+def current_api_memory_write():
+    return _API_MEMORY_WRITE.get()
+
+
+def api_memory_write_allowed(run_id=None, session_id=None):
+    policy = current_api_memory_write()
+    if policy is None:
+        return not memory_write_policy_required()
+    expected_run, expected_session, allowed = policy
+    if allowed is False:
+        return False
+    if allowed is None:
+        return not memory_write_policy_required()
+    current_run = get_api_run_id(str(_SESSION_ID.get()))
+    return (current_run == expected_run and (run_id is None or run_id == expected_run)
+            and (session_id is None or session_id == expected_session))
+
+
+def get_api_run_id(session_id: str) -> str:
+    """Technical run key bound by the native API owner; no env fallback or business grant."""
+    if _SESSION_PLATFORM.get() != "api_server":
+        return ""
+    key = _SESSION_KEY.get()
+    if _SESSION_ID.get() != session_id:
+        policy = _API_MEMORY_WRITE.get()
+        if policy is None or session_id != policy[1] or key != policy[0]:
+            return ""
+    return key if isinstance(key, str) else ""
+
+
 def get_session_env(name: str, default: str = "") -> str:
     """Read a session var by legacy ``HERMES_SESSION_*`` name; drop-in for os.getenv.  The
     ContextVar wins if ever set here (even to ``""``); else ``os.environ``; else *default*."""
