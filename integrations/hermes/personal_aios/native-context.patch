+def test_cross_process_wait_adoption_rebinds_native_api_context(native_scope, monkeypatch):
+    db, agent = native_scope
+    worker = subprocess.Popen([sys.executable, "-c", '''
+import sys
+from pathlib import Path
+from hermes_state import SessionDB
+db = SessionDB(Path(sys.argv[1]))
+assert db.acquire_session_turn_lease("admitted-parent", "prior-process", wait_seconds=0)
+print("owned", flush=True)
+sys.stdin.readline()
+db.publish_compression_child(parent_session_id="admitted-parent", child_session_id="wait-child",
+    source="api_server", messages=[{"role":"user","content":"cross-process handoff"}],
+    require_compression_lease=False)
+db.release_session_turn_lease("admitted-parent", "prior-process")
+db.close()
+print("published-and-released", flush=True)
+''', str(db.db_path)], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    lease = None
+    try:
+        started = worker.stdout.readline().strip()
+        assert started == "owned", worker.stderr.read() if not started else started
+        original = db.acquire_session_turn_lease
+        signalled = False
+        def acquire(*args, **kwargs):
+            on_wait = kwargs["on_wait"]
+            def waited(elapsed):
+                nonlocal signalled
+                on_wait(elapsed)
+                if not signalled:
+                    signalled = True
+                    worker.stdin.write("publish\n"); worker.stdin.flush()
+            return original(*args, **{**kwargs, "on_wait": waited})
+        monkeypatch.setattr(db, "acquire_session_turn_lease", acquire)
+        monkeypatch.setattr("agent.turn_liveness.resolve_turn_liveness_settings", lambda cfg: (None, 1.0))
+        agent._emit_status = lambda value: None
+        ctx = {"session_id": "admitted-parent", "platform": "api_server", "task_id": "logical-run"}
+        admission = admit_durable_turn_lease(agent, session_id="admitted-parent", relay_turn_id="synthetic",
+            task_context=ctx, conversation_history=[])
+        lease = admission.lease
+        assert signalled and lease is not None and agent.session_id == "wait-child"
+        assert ctx["session_id"] == "wait-child" and admission.conversation_history
+        identity = dispatch_memory_provider_tool(agent, "source-consumer", {}, "after-wait")
+        assert identity == {"session_id": "admitted-parent", "run_id": "logical-run", "tool_call_id": "after-wait"}
+        assert worker.wait(timeout=10) == 0
+    finally:
+        if lease is not None:
+            lease.release()
