+                assert not attempted
+                foreign_source = agent._memory_effect_db.read_memory_effects("foreign-run")["memory_receipt_source"]
+                assert foreign_source["receipts"] == [] and foreign_source["unsettled_attempts"] == []
+                assert "Approved 1" in handle_pending_subcommand("memory", ["approve", staged["pending_id"]], memory_store=agent._memory_store)
