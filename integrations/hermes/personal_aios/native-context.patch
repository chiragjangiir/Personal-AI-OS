+        assert "root@workshop" in command and "/owner/key" in command
+        assert f"OUT=/owner/out/{env._session_id}" in command[-1]
+        assert env._forward_credentials is False
+        assert env._sync_workshop_skills is False
+        assert len(probes) == 3  # Initial miss, publication verification, pre-execution verification.
+        assert uploaded == [("skills/workshop/registered/run.py",
+                             f"{env._remote_home}/.hermes/.skills-{env._session_id}/workshop/registered/run.py")]
+        _mock_ssh_runtime["sync_factory"].assert_not_called()
+        env.cleanup()
