+    legacy=wa.stage_write('memory',{'action':'add','target':'memory','content':'Legacy synthetic.'},summary='Legacy',origin='foreground')
+    discard=wa.discard_pending
+    with patch.object(wa,'discard_pending',side_effect=lambda subsystem,pid:False if pid==record['id'] else discard(subsystem,pid)):
+        text=handle_pending_subcommand('memory',['reject','all'])
+    assert 'Durable rejected decisions: 2' in text and 'Pending removed: 2' in text
+    assert 'Known cleanup outstanding: 1' in text and 'Cleanup removal unknown: 0' in text
