+    def upload(self, files):
+        uploaded.extend((Path(local).read_text(), remote) for local, remote in files)
+    monkeypatch.setattr(SSHEnvironment, "_ssh_bulk_upload", upload)
+    probes = []
+    def probe(self, command, **kwargs):
+        probes.append(command)
+        return subprocess.CompletedProcess([], 0, stdout=expected if uploaded else "MISSING\0", stderr="")
+    monkeypatch.setattr(SSHEnvironment, "_run_ssh", probe)
+    monkeypatch.setattr(SSHEnvironment, "_run_ssh_checked", MagicMock())
+    spawn = MagicMock(side_effect=lambda *a, **k: subprocess.Popen(
+        ["/bin/bash", "-c", "printf owner-remote"], stdout=subprocess.PIPE, text=True))
+    monkeypatch.setattr(ssh_env, "_popen_bash", spawn)
+    with pytest.raises(ValueError, match="owner action grant"):
+        SSHEnvironment(host="workshop", user="root", key_path="/owner/key")
+    with run_scope.runtime_scope("owner", ["terminal", "file"]):
+        env = SSHEnvironment(host="workshop", user="root", key_path="/owner/key")
+        assert env.execute("echo $OUT")["output"] == "owner-remote"
+        command = spawn.call_args.args[0]
