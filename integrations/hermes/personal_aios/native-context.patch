index 0000000000000000000000000000000000000000..64bc332eef7fec14e870a9af55191236facfae94
--- /dev/null
+++ b/gateway/platforms/api_run_amendment.py
@@ -0,0 +1,58 @@
+"""Durable steer receipts in the native run idempotency store."""
+import hashlib
+import json
+
+
+def initialize(conn):
+    """Keep replay identity, never the original steer text, including legacy orphans."""
+    conn.execute("""CREATE TABLE IF NOT EXISTS run_amendments (
+        scope TEXT NOT NULL, run_id TEXT NOT NULL, amendment_id TEXT NOT NULL,
+        text TEXT NOT NULL, receipt TEXT, PRIMARY KEY(scope,run_id,amendment_id))""")
+    columns = {row[1] for row in conn.execute("PRAGMA table_info(run_amendments)")}
+    if "text_format" not in columns:
+        conn.execute("ALTER TABLE run_amendments ADD COLUMN text_format TEXT NOT NULL DEFAULT 'raw'")
+    for scope, run_id, amendment_id, text in conn.execute(
+            "SELECT scope,run_id,amendment_id,text FROM run_amendments WHERE text_format='raw'").fetchall():
+        conn.execute("UPDATE run_amendments SET text=?,text_format='sha256' "
+                     "WHERE scope=? AND run_id=? AND amendment_id=?",
+                     (hashlib.sha256(text.encode()).hexdigest(), scope, run_id, amendment_id))
+
+
+def retire(conn, scope, run_id, reason):
+    """Retain digest tombstones so consumed or uncertain deliveries cannot execute again."""
+    conn.execute("UPDATE run_amendments SET receipt=? WHERE scope=? AND run_id=?",
+                 (json.dumps({"error": reason}), scope, run_id))
+
+
+def amend(store, scope, run_id, amendment_id, text, deliver):
+    if not amendment_id:
+        return deliver()
+    if not store.durable:
+        return {"error": "durable_amendment_store_unavailable"}
+    key = (scope, run_id, amendment_id)
+    digest = hashlib.sha256(text.encode()).hexdigest()
+    with store._immediate_txn():
+        row = store._conn.execute("SELECT text,receipt FROM run_amendments WHERE scope=? AND run_id=? AND amendment_id=?", key).fetchone()
+        if row is not None:
+            if row[0] != digest:
+                store._conn.commit()
+                return {"error": "amendment_id_conflict"}
+            if row[1] is None:
+                store._conn.commit()
+                return {"error": "amendment_delivery_uncertain", "amendment_id": amendment_id}
+            receipt = json.loads(row[1])
+            if receipt.get("error") not in {"run_not_accepting_steer", "steer_not_accepted"}:
+                store._conn.commit()
+                return receipt
+            # These refusals prove nothing was queued. A later live boundary may accept the same requirement.
+            store._conn.execute("UPDATE run_amendments SET receipt=NULL WHERE scope=? AND run_id=? AND amendment_id=?", key)
+        else:
+            store._conn.execute("INSERT INTO run_amendments(scope,run_id,amendment_id,text,text_format) VALUES(?,?,?,?,'sha256')", (*key, digest))
+        store._conn.commit()
+    # Once pending is durable, an interrupted delivery is visible and never blindly replayed.
+    receipt = deliver()
+    with store._immediate_txn():
+        store._conn.execute("UPDATE run_amendments SET receipt=? WHERE scope=? AND run_id=? AND amendment_id=? AND receipt IS NULL",
+                            (json.dumps(receipt), *key))
+        store._conn.commit()
+    return receipt
diff --git a/gateway/platforms/api_run_delegation.py b/gateway/platforms/api_run_delegation.py
new file mode 100644
index 0000000000000000000000000000000000000000..ad1226a7f534062f5c6e47e93f2d549a5fc2c98c
--- /dev/null
+++ b/gateway/platforms/api_run_delegation.py
@@ -0,0 +1,174 @@
+"""Bridge native async delegate completion into its owning /v1/runs lifecycle."""
+import json
+import queue
+
+
+class RunDelegation:
+    def __init__(self, agent, publish):
+        self.agent = agent
+        self.publish = publish
+        self.results = queue.Queue()
+        # Save this exact bound method object: native records compare callback identity.
+        self.callback = self.results.put
+        agent._native_delegate_completion = self.callback
+
+    def _live(self):
+        from tools.async_delegation import _records, _records_lock, _LIVE_STATES
+        with _records_lock:
+            return [dict(r) for r in _records.values()
+                    if r.get("completion_callback") is self.callback and r.get("status") in _LIVE_STATES]
+
+    def initial(self, text, history, run_conversation):
+        event = None
+        if getattr(self.agent, "_paios_delegate_toolsets", None):
+            try:
+                d = json.loads(text)
+            except (ValueError, TypeError):
+                d = {}
+            app = d.get("content", {}).get("app_event", {}) if isinstance(d, dict) else {}
+            if isinstance(d, dict) and d.get('principal_id'):
+                self.agent._paios_principal_id = d['principal_id']
+            if isinstance(d, dict) and d.get("origin") == "device_observation" and app.get("kind") in {"errand_result", "errand_delivery_failed", "task_failure"}:
+                event = {"delegation_id": app["job_id"], "kind": app["kind"], "job_id": app["job_id"], "source": app.get("failure_source", "errand"), "goal": app.get("title") or app.get("task") or "Phone task",
+                         "status": app.get("terminal_reason"), "self_check_of": app.get("self_check_of"),
+                         "error": app.get("error") or app.get("error_code") or app.get("answer"), "task": app.get("task"), "evidence_ref": app.get("evidence_ref"),
+                         **{k: app[k] for k in ('stage', 'reason', 'execution', 'delivery', 'task_retry_allowed') if k in app}}
+        result = run_conversation(text, history, message_role="system" if event else "user")
+        if event and result.get("failure_reason") != "session_busy":
+            self._start_failure_selfchecks([event])
+        return result
+
+    def _start_failure_selfchecks(self, events):
+        if not getattr(self.agent, "_paios_delegate_toolsets", None) or getattr(self.agent, "_interrupt_requested", False):
+            return
+        from tools.delegate_tool import delegate_task
+        from tools.async_delegation import selfcheck_dispatched
+        for event in events:
+            if event.get("self_check_of"):
+                continue
+            for entry in event.get("results", [event]):
+                if entry.get("status") not in {"failed", "error", "timeout", "timed_out", "interrupted"}:
+                    continue
+                failure = self.failure_metadata(event, entry)
+                if entry.get("cancelled_by_user") or selfcheck_dispatched(failure["id"]):
+                    continue
+                dispatch = delegate_task(goal="自检：" + failure["title"],
+                    context='First use skill_view(name="failure-selfcheck") and follow that skill. Failure evidence:\n' + json.dumps(failure, ensure_ascii=False),
+                    background=True, parent_agent=self.agent, failure_context=failure,
+                    self_check_of={"source": failure["source"], "id": failure["id"]})
+                entry["selfcheck_dispatch"] = admitted = json.loads(dispatch)
+                if admitted.get("status") != "dispatched":
+                    self.callback({"type": "selfcheck_admission", "delegation_id": failure["id"],
+                        "self_check_of": failure["id"], "goal": "自检：" + failure["title"],
+                        "status": "error", "error": admitted.get("error"), "summary": "Selfcheck was not started."})
+
+    @staticmethod
+    def failure_metadata(event, entry):
+        index = entry.get("task_index", 0)
+        title = (event.get("goals") or [event.get("goal") or "Background task"])[index]
+        outcome = entry.get("outcome")
+        return {"source": event.get("source", "delegate"), "id": f"{event['delegation_id']}:{index}",
+            "title": title, "task": entry.get("task") or event.get("task") or title,
+            "terminal_reason": entry.get("failure_reason") or entry.get("exit_reason") or entry.get("status", event.get("status")),
+            "error": entry.get("error"), "summary": entry.get("summary"),
+            **({'reported_outcome': {'outcome': outcome, 'reason': entry.get('outcome_reason')}} if outcome is not None else {}),
+            **{k: event[k] for k in ('kind', 'job_id', 'stage', 'reason', 'execution', 'delivery', 'task_retry_allowed') if k in event},
+            "evidence_ref": event.get("evidence_ref") or {"tool": "session_search", "session_id": entry.get("session_id"),
+                "transcripts": event.get("live_transcripts") or []}}
+
+    def resume(self, result, run_conversation):
+        while self._live() or not self.results.empty():
+            self.current_result = result
+            self.publish(True)
+            events = []
+            while not events and (self._live() or not self.results.empty()):
+                if getattr(self.agent, "_interrupt_requested", False):
+                    for record in self._live():
+                        interrupt = record.get("interrupt_fn")
+                        if interrupt:
+                            interrupt()
+                    return {**result, "interrupted": True, "final_response": "Delegated work interrupted."}
+                try:
+                    events.append(self.results.get(timeout=0.25))
+                except queue.Empty:
+                    continue
+            while not self.results.empty():
+                events.append(self.results.get_nowait())
+            self.publish(False)
+            from tools.async_delegation import claim_event_delivery, release_completion_delivery
+            claimed = [(event, claim_event_delivery(event, "api_run")) for event in events]
+            events = [event for event, claim in claimed if claim is not None]
+            if not events:
+                continue
+            for event in events:
+                for entry in event.get("results", [event]):
+                    if (entry.get("status", event.get("status")) in {"failed", "error", "timeout", "timed_out", "interrupted"}
+                            or entry.get("outcome") in {"partial", "failed", "cancelled"} or entry.get("truncated")):
+                        failure = self.failure_metadata(event, entry)
+                        del failure["summary"]  # The same entry already carries the exact child summary.
+                        entry["failure_context"] = failure
+            history = result.get("messages", [])
+            db = getattr(self.agent, "_session_db", None)
+            if db is not None:
+                from agent.session_persistence import _db_flush_adopt_compression_tip
+                _db_flush_adopt_compression_tip(self.agent)
+                history = db.get_messages_as_conversation(self.agent.session_id, include_row_ids=True)
+            text = self.completion_input(events, history, self._prior_reports(events))
+            if any(event.get("self_check_of") for event in events):
+                text += "\nThis is a selfcheck result. Report its failure and register an existing Kanban issue if available; do not launch another selfcheck."
+            result = run_conversation(text, history)
+            if db is not None:
+                lineage = db._resume_lineage_ids(self.agent.session_id)
+                ingested = db._read_one(
+                    "SELECT 1 FROM messages WHERE session_id IN (" + ",".join("?" for _ in lineage)
+                    + ") AND role='system' AND content=? LIMIT 1", (*lineage, text))
+                if ingested:
+                    from tools.async_delegation import mark_completion_delivered, is_interim_delegation_event
+                    for event in events:
+                        if not is_interim_delegation_event(event):
+                            mark_completion_delivered(event["delegation_id"])
+                    self._start_failure_selfchecks(events)
+                elif result.get("failure_reason") == "session_busy":
+                    # No input was ingested or tool invoked. Retry this same run through the native lease wait.
+                    for event, claim in claimed:
+                        if claim:
+                            release_completion_delivery(event["delegation_id"], claim)
+                        if claim is not None:
+                            self.results.put(event)
+            else:
+                self._start_failure_selfchecks(events)
+        return result
+
+    def _prior_reports(self, events):
+        if not getattr(self.agent, '_paios_principal_id', None):
+            return []
+        from gateway.platforms.api_run_reporting import task_job_ids
+        jobs = list(dict.fromkeys(job for event in events
+                    for entry in [event, *event.get('results', [])] for job in task_job_ids(entry)))
+        if not jobs:
+            return []
+        from gateway.session_context import get_api_run_id
+        provider = self.agent._memory_manager.get_provider('personal_aios')
+        context = {'run_id': get_api_run_id(self.agent.session_id),
+                   'session_id': self.agent._paios_tool_conversation}
+        reports = []
+        for offset in range(0, len(jobs), 16):
+            reports.extend(provider.errand_report_context(context, jobs[offset:offset + 16]))
+        return reports
+
+    @staticmethod
+    def completion_input(events, history, prior_reports=()):
+        from gateway.platforms.api_run_reporting import completion_input
+        return completion_input(events, history, prior_reports)
+
+
+def steer_delegates(agent, text):
+    from tools.delegate_tool_registry import (_active_subagents, _active_subagents_lock,
+        _is_descendant_of, steer_subagent)
+    with _active_subagents_lock:
+        ids = [sid for sid, record in _active_subagents.items()
+               if _is_descendant_of(record.get("agent"), agent) and record.get("accepting_steer")]
+    delivered = [sid for sid in ids if steer_subagent(sid, text)]
+    if delivered:
+        return "delegate", delivered
+    return ("parent_replan", []) if agent.steer(text) else (None, [])
diff --git a/gateway/platforms/api_run_reporting.py b/gateway/platforms/api_run_reporting.py
new file mode 100644
index 0000000000000000000000000000000000000000..dad82038e7976d76a1322e437737471c1ed8446c
--- /dev/null
+++ b/gateway/platforms/api_run_reporting.py
@@ -0,0 +1,305 @@
+"""Project native transcript records into delegated reporting facts."""
+import json
+
+
+def tool_result_record(content):
+    """Decode Hermes' own trust frame and the MCP result envelope, retaining metadata."""
+    if isinstance(content, str) and content.startswith('<untrusted_tool_result source="'):
+        _, separator, payload = content.partition('\n\n')
+        if not separator or not payload.endswith('\n</untrusted_tool_result>'):
+            return None
+        content = payload.removesuffix('\n</untrusted_tool_result>')
+    try:
+        result = json.loads(content) if isinstance(content, str) else content
+        if isinstance(result, dict) and isinstance(result.get('result'), str):
+            nested = json.loads(result['result'])
+            if isinstance(nested, dict):
+                result = {**nested, **{k: v for k, v in result.items() if k != 'result'}}
+    except (ValueError, TypeError):
+        return None
+    return result if isinstance(result, dict) else None
+
+
+def confirmation_receipts(messages):
+    calls, receipts = {}, []
+    for message in messages:
+        for call in message.get('tool_calls') or []:
+            function = call.get('function', {})
+            name = function.get('name')
+            request = tool_result_record(function.get('arguments'))
+            if name in {'phone_task', 'mcp__phone__phone_task', 'phone_status', 'mcp__phone__phone_status',
+                        'send_message', 'paios_effect_check'} or (
+                    name == 'skills_hub' and request is not None and request.get('action') == 'release_decide'):
+                calls[call['id']] = name
+        if message.get('role') != 'tool' or message.get('tool_call_id') not in calls:
+            continue
+        result = tool_result_record(message.get('content'))
+        if result is None:
+            continue
+        confirmation = result.get('approval') or result.get('confirmation')
+        if confirmation is None and 'confirmed_by' in result:
+            confirmation = {k: result[k] for k in ('confirmation_id', 'confirmed_by', 'confirmed_at', 'surface',
+                'decision_status', 'decision', 'decision_source', 'choice', 'reason', 'lifecycle', 'reused',
+                'confirmation_evidence') if k in result}
+        if not isinstance(confirmation, dict) or not confirmation.get('confirmation_id'):
+            continue
+        receipts.append({'tool_call_id': message.get('tool_call_id'),
+            'tool': calls.get(message.get('tool_call_id')) or message.get('tool_name'),
+            **{k: result[k] for k in ('job_id', 'request_id', 'approved') if k in result},
+            'confirmation': confirmation})
+    return receipts
+
+
+def _execution_records(entry):
+    for record in entry.get('task_records', []):
+        tool = record.get('tool')
+        if tool not in ('phone_task', 'mcp__phone__phone_task', 'phone_status', 'mcp__phone__phone_status'):
+            continue
+        request, result = record['request'], record['result']
+        if tool in ('phone_task', 'mcp__phone__phone_task'):
+            if result.get('job_id'):
+                yield record, result
+        elif request.get('job_id'):
+            for value in [result, *result.get('jobs', [])]:
+                if value.get('job_id') == request['job_id']:
+                    yield record, value
+
+
+def task_job_ids(entry):
+    """Resolve task membership from bound source identity and actual execution receipts."""
+    source = entry.get('source_failure') or {}
+    values = [entry, entry.get('evidence_ref') or {}, source.get('evidence_ref') or {},
+              *(value for _, value in _execution_records(entry))]
+    jobs = [entry['delegation_id']] if entry.get('source') == 'errand' else []
+    jobs.extend(value['job_id'] for value in values if value.get('job_id'))
+    return list(dict.fromkeys(jobs))
+
+
+def _task_scope(entry, reports):
+    jobs = task_job_ids(entry)
+    receipts = list(_execution_records(entry))
+    scope = {'job_ids': jobs, 'prior_report_refs': [
+        {'job_id': report['job_id'], 'index': index} for index, report in enumerate(reports)
+        if report.get('job_id') in jobs]}
+    delta = []
+    fields = ('success', 'terminal_reason', 'answer', 'finished_at', 'partial_findings', 'trace',
+              'execution', 'delivery', 'task_retry_allowed')
+    for index, report in enumerate(reports):
+        if report.get('status') != 'sealed' or report.get('generated') is not True or 'source_event' not in report:
+            continue
+        before = report['source_event']
+        for record, current in receipts:
+            if before['job_id'] != report['job_id'] or current['job_id'] != report['job_id'] or not current.get('terminal_reason'):
+                continue
+            compared = [key for key in fields if key in current]
+            delta.append({'job_id': current['job_id'], 'prior_report_index': index,
+                'tool_call_id': record['tool_call_id'],
+                'unchanged_source_fields': [key for key in compared if key in before and current[key] == before[key]],
+                'changed_source_fields': [key for key in compared if key in before and current[key] != before[key]],
+                'additional_source_fields': [key for key in compared if key not in before]})
+    if delta:
+        scope['report_delta'] = delta
+    return scope
+
+
+def completion_input(events, history, prior_reports=()):
+    reports = list(prior_reports)
+    reported_text = {report.get('reply_text') for report in reports}
+    local_reports = [{'message_id': m.get('_row_id') or m.get('message_id'), 'text': m['content']}
+               for m in history if m.get('role') == 'assistant' and not m.get('tool_calls')
+               and m.get('content') and m.get('display_kind') != 'agent_intent' and m['content'] not in reported_text]
+    agent_reports, completion_events = [], []
+    for event in events:
+        projected = dict(event)
+        completion_scope = {'kind': 'delegation_batch' if 'results' in event else 'delegated_task',
+                            'delegation_id': event['delegation_id']}
+        entries = []
+        for entry in event.get('results', [event]):
+            facts = dict(entry)
+            facts['task_scope'] = _task_scope(entry, reports)
+            claims = {key: facts.pop(key) for key in ('summary', 'result', 'outcome', 'outcome_reason') if key in facts}
+            for name in ('failure_context', 'source_failure'):
+                if name not in facts:
+                    continue
+                context = dict(facts[name])
+                reported = {key: context.pop(key) for key in ('summary', 'reported_outcome', 'outcome', 'outcome_reason')
+                            if key in context and context[key] is not None}
+                if reported:
+                    claims[name] = reported
+                facts[name] = context
+            if claims:
+                agent_reports.append({'kind': 'model_claims', 'delegation_id': event['delegation_id'],
+                    'task_index': entry.get('task_index', 0), 'session_id': entry.get('session_id'), **claims})
+            entries.append(facts)
+        if 'results' in event:
+            projected['results'] = entries
+        else:
+            projected = entries[0]
+        projected['completion_scope'] = completion_scope
+        completion_events.append(projected)
