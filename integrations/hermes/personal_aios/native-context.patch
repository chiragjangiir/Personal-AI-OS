--- /dev/null
+++ b/gateway/run_scope.py
@@ -0,0 +1,250 @@
+"""Personal-AIOS admitted tool scope for one API run.
+
+The host (Personal-AIOS integration) decides the scope from its local voiceprint registry and sends it on the
+authenticated run body; Hermes enforces it here. ``owner`` (or no ``run_scope``) is unchanged Hermes behavior.
+
+* ``guest``: another person. Isolated per-speaker session (never the owner's history), no built-in memory snapshot,
+  no memory writes, only plain chat, web search and reply routing.
+* ``owner_uncertain``: a directed request whose voice did not verify as owner (including another voice or no usable result). The controller conversation stays bound, but each native
+  transcript is isolated. Memory writes are off; the same tool allowlist applies until the owner completes the paired terminal's biometric check for "确认是我" (the host re-admits the request).
+* ``care``: an authenticated care_decision, derived by the API. Supplied episode context, health, reply and non-executing question/call-offer cards only.
+"""
+import hashlib
+import json
+from contextlib import contextmanager
+from contextvars import ContextVar
+from pathlib import Path
+import re
+
+RUN_SCOPES = ("owner", "owner_uncertain", "guest", "build")
+_scope = ContextVar("admitted_run_scope", default="owner")
+_grants = ContextVar("admitted_action_grants", default=frozenset())
+
+
+def current_action_grants():
+    return _grants.get()
+
+
+def current_scope():
+    return _scope.get()
+
+
+def current_build_origin():
+    """Return the admitted build input's origin, never a tool-supplied value."""
+    from tools.personal_aios_dispatch import current_tool_call
+    bound = current_tool_call.get()
+    return getattr(bound[0], "_paios_build_origin", None) if bound is not None else None
+
+
+def current_selfcheck_origin():
+    """Recover the native self-check marker from its existing delegation row."""
+    from contextlib import closing
+    from tools.personal_aios_dispatch import current_tool_call
+    bound = current_tool_call.get()
+    failure_id = getattr(bound[0], "_self_check_of", None) if bound is not None else None
+    if failure_id is None:
+        return None
+    if current_scope() != "owner":
+        raise ValueError("System self-check repair requires the confirmed owner scope")
+    from tools.async_delegation import _connect
+    with closing(_connect()) as conn:
+        row = conn.execute("SELECT task_json FROM async_delegations WHERE json_extract(task_json, '$.self_check_of.id')=?",
+                           (failure_id,)).fetchone()
+        if row is None:
+            raise ValueError("System self-check requires its native delegation record")
+        marker = json.loads(row[0])["self_check_of"]
+        if marker["source"] == "delegate":
+            delegation_id, index = failure_id.rsplit(":", 1)
+            failed = conn.execute("SELECT task_json,result_json FROM async_delegations WHERE delegation_id=?",
+                                  (delegation_id,)).fetchone()
+            if failed is None:
+                raise ValueError("Self-check failure evidence is missing")
+            task, result = json.loads(failed[0]), json.loads(failed[1])
+            entry = next((entry for entry in result.get("results", [result]) if entry.get("task_index", 0) == int(index)), None)
+            if entry is None or not entry.get("session_id"):
+                raise ValueError("Self-check failed child transcript is missing")
+            marker = {**marker, "title": (task.get("goals") or [task["goal"]])[int(index)],
+                      "evidence_ref": {"tool": "session_search", "session_id": entry["session_id"]}}
+    return marker
+
+
+@contextmanager
+def runtime_scope(scope, granted_toolsets=()):
+    """Build tools use a separate native home; no owner skill, memory or config inheritance."""
+    token = _scope.set(scope)
+    grant_token = _grants.set(frozenset(granted_toolsets))
+    try:
+        if scope == "build":
+            from hermes_constants import get_hermes_home
+            from gateway.run import _profile_runtime_scope
+            from hermes_cli.config import load_config, get_compatible_custom_providers
+            from hermes_cli.auth import PROVIDER_REGISTRY
+            from hermes_cli.runtime_provider import _get_model_config
+            from agent.secret_scope import get_secret
+            config = load_config()
+            names = {name for provider in PROVIDER_REGISTRY.values() for name in provider.api_key_env_vars}
+            names.update(provider.base_url_env_var for provider in PROVIDER_REGISTRY.values() if provider.base_url_env_var)
+            for provider in [_get_model_config(), *get_compatible_custom_providers(config)]:
+                names.update(provider[key] for key in ("key_env", "api_key_env") if provider.get(key))
+            model_secrets = {name: value for name in names if (value := get_secret(name)) is not None}
+            home = get_hermes_home() / "workshop"
+            if not (home / "config.yaml").is_file():
+                raise ValueError("Build profile is not configured")
+            with _profile_runtime_scope(home, model_secrets):
+                yield
+        else:
+            yield
+    finally:
+        _scope.reset(token)
+        _grants.reset(grant_token)
+# Plain chat plus web search; ``paios_open_reply`` is the host's reply routing (the host refuses its other tools too).
+# Everything else -- memory, session_search, phone executor/errands, messaging, delegation, skills, terminal, files,
+# browser, cron, vision -- is withheld from the tool surface and refused at dispatch.
+_SHAPE = json.loads((Path(__file__).parent / "platforms/native-run.shape.schema.json").read_text())
+ADMITTED_TOOLS = {scope: frozenset(names) for scope, names in _SHAPE["x-paios-run-scope-tools"].items()}
+# "memory" stays enabled only because it gates the host memory provider (paios_open_reply); its own tool is removed.
+RESTRICTED_TOOLSETS = frozenset({"web", "memory"})
+_GUEST_KEY = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$")
+
+NOTES = {
+    "build": "【工坊构建】只使用本次已授权的构建输入、其真实来源和已保存的工坊技能。没有主人资料、记忆或会话历史；不能创建定时任务。",
+    "guest": (
+        "【访客模式】本轮说话人不是已验证的主人。只能闲聊、回答常识问题，可以联网搜索。"
+        "不能读取或透露主人的记忆、消息、位置、健康、日程或日志，不能下单、打车、发消息或让手机执行任何操作，也不写入记忆。"
+        "被要求做这些事时，礼貌说明需要主人本人来。"),
+    "owner_uncertain": (
+        "【声纹未确认】本轮没有通过声音确认主人身份。可能是其他人的声音，也可能没有可用的识别结果。可以继续聊天、回答常识问题、联网搜索。"
+        "涉及主人隐私（记忆、消息、位置、健康、日志）或任何操作（下单、打车、发消息、手机执行）的工具本轮已停用："
+        "只有本轮原生输入顶层 voice_confirmation 含 confirmation_id 且 expires_at_ms 尚未过期，才说明本轮没能确认声音，请对方在配对手机上点“确认是我”并完成 Face ID，确认后原请求会以主人身份重新处理。若本轮明确提供 Mac Touch ID 确认入口，也可按该入口完成 Touch ID。该事实缺失、为 null 或已过期时，明确说明本轮没能确认声音，请主人从配对手机打字发送请求；手机文字请求按主人身份处理。不能从 D、历史轮次或声纹身份推定有确认卡。"),
+    "care": (
+        "【关心决策】只使用本次关心事件附带的上下文、健康查询、回复声明、普通提问卡或中性通话邀请卡。不能读取主人历史、记忆、日志、视觉记忆或人物资料。用一句话关心主人，或保持安静。"
+        "提问卡与通话邀请卡只展示选项，不授予执行权限。发现可办的事只能提及，等主人明确提出后由正常主人轮次执行。"),
+}
+
+
+def run_scope_request(body, memory_write):
+    """Validate the authenticated run body's scope fields; never inspect model input. Returns ``(scope, guest_key)``."""
+    scope = body.get("run_scope", "owner")
+    if scope not in RUN_SCOPES:
+        raise ValueError("run_scope must be owner, owner_uncertain, guest or build")
+    guest_key = body.get("guest_key")
+    if (scope == "guest") != (guest_key is not None):
+        raise ValueError("guest_key is required exactly for run_scope guest")
+    if guest_key is not None and (not isinstance(guest_key, str) or not _GUEST_KEY.match(guest_key)):
+        raise ValueError("guest_key is invalid")
+    if scope != "owner":
+        if memory_write is True:
+            raise ValueError("a restricted run_scope cannot write memory")
+        if not body.get("session_id") or body.get("previous_response_id") or body.get("conversation_history"):
+            raise ValueError("a restricted run_scope needs an explicit session_id and no caller-supplied history")
+    return scope, guest_key
+
+
+def action_grants(body, scope, config):
+    """Only authenticated owner run fields can enable configured action toolsets."""
+    allowed = config.get("personal_aios", {}).get("grantable_toolsets", [])
+    grants = body.get("grant_toolsets", [])
+    if (not isinstance(allowed, list) or not all(isinstance(n, str) for n in allowed)
+            or not isinstance(grants, list) or not all(isinstance(n, str) for n in grants)
+            or len(set(grants)) != len(grants) or not set(grants) <= set(allowed)
+            or grants and scope != "owner"):
+        raise ValueError("grant_toolsets require an owner non-care run and configured names")
+    return sorted(grants)
+
+
+def bind_action_grants(agent, grants, config):
+    from toolsets import resolve_toolset
+    allowed = config.get("personal_aios", {}).get("grantable_toolsets", [])
+    agent._paios_action_denied = set().union(*(set(resolve_toolset(n)) for n in allowed if n not in grants))
+    agent._paios_desktop_denied = "desktop" in allowed and "desktop" not in grants
+
+
+def _action_denied(agent, name):
+    return (name in getattr(agent, "_paios_action_denied", set()) or
+            getattr(agent, "_paios_desktop_denied", False) is True and
+            name.startswith(("mcp__desktop__", "mcp_desktop_")))
+
+
+def guest_session_id(conversation_session_id, guest_key):
+    """The guest transcript: derived here, so a host error can never name an owner session."""
+    digest = hashlib.sha256(f"{conversation_session_id}\0{guest_key}".encode("utf-8")).hexdigest()[:40]
+    return f"paios-guest-{digest}"
+
+
+def _restricted(scope):
+    # Only restrict_agent sets the attribute, always to a validated restricted scope; anything else is an owner run.
+    return isinstance(scope, str) and scope in ADMITTED_TOOLS
+
+
+def with_note(instructions, scope):
+    if not _restricted(scope):
+        return instructions
+    return f"{instructions}\n\n{NOTES[scope]}" if instructions else NOTES[scope]
+
+
+def _tool_name(tool):
+    function = tool.get("function") if isinstance(tool, dict) else None
+    return function.get("name") if isinstance(function, dict) else None
+
+
+# Conversation tools declare replies/questions, read knowledge, inspect their own runtime or register backlog
+# findings. Other execution, verification, waits and device status queries belong to a native child.
+CONVERSATION_TOOLS = frozenset({
+    "delegate_task", "clarify", "skills_list", "skill_view", "session_search",
+    "paios_background_status",
+    "mcp__self__runtime_query", "mcp__self__runtime_status",
+    "paios_open_reply", "paios_terminal_question", "paios_call_offer",
+    "paios_l3_query", "paios_l3_inspect", "paios_l5_locate", "paios_l5_read",
+    "paios_ambient_journal_search", "paios_visual_recall",
+    "kanban_create", "kanban_list", "kanban_show",
+})
+
+
+def _conversation_only(agent):
+    return bool(getattr(agent, "_paios_delegate_toolsets", None)) and not getattr(agent, "_delegate_depth", 0)
+
+
+def _bind_delegated_toolsets(agent):
+    if getattr(agent, "platform", None) not in {"api_server", "cron"} or getattr(agent, "_delegate_depth", 0):
+        return
+    from hermes_cli.config import load_config
+    config = load_config()
+    catalog = config.get("personal_aios", {}).get("delegated_toolsets", [])
+    if catalog:
+        agent._paios_delegate_toolsets = catalog
+        if agent.platform == "cron":
+            bind_action_grants(agent, current_action_grants(), config)
+
+
+def restrict_agent(agent, scope):
+    """Withhold background review and every non-allowlisted tool. Idempotent: re-applied
+    after a continuing session restores its pinned tools."""
+    _bind_delegated_toolsets(agent)
+    tools = [tool for tool in (getattr(agent, "tools", None) or [])
+             if not _action_denied(agent, _tool_name(tool) or "")
+             and (not _conversation_only(agent) or _tool_name(tool) in CONVERSATION_TOOLS)]
+    agent.tools = tools
+    agent.valid_tool_names = {_tool_name(tool) for tool in tools}
+    if not _restricted(scope):
+        return
+    agent._paios_run_scope = scope
+    agent._memory_store = None
+    agent._memory_enabled = False
+    agent._user_profile_enabled = False
+    agent.skip_background_review = True
+    tools = [tool for tool in (getattr(agent, "tools", None) or []) if _tool_name(tool) in ADMITTED_TOOLS[scope]
+             or _conversation_only(agent) and _tool_name(tool) == "delegate_task"]
+    agent.tools = tools
+    agent.valid_tool_names = {_tool_name(tool) for tool in tools}
+
+
+def tool_block(agent, name):
+    """The dispatch authority: whatever the surface advertised, a restricted run executes only allowlisted tools."""
+    if _action_denied(agent, name):
+        return f"Tool '{name}' requires an owner action grant."
+    if _conversation_only(agent) and name not in CONVERSATION_TOOLS:
+        return f"Tool '{name}' must execute in a native delegated child."
+    scope = getattr(agent, "_paios_run_scope", None)
+    if not _restricted(scope) or name in ADMITTED_TOOLS[scope] or _conversation_only(agent) and name == "delegate_task":
+        return None
+    return f"Tool '{name}' is not available in run_scope {scope}. {NOTES[scope]}"
