+            assert source["status"] == "complete" and source["unsettled_attempts"] == []
+            assert all(r["summary"]["profile_home"] == str((tmp_path / profile).resolve()) for r in source["receipts"])
+            missing = agent._memory_effect_db.read_memory_effects("other")["memory_receipt_source"]
+            assert missing["status"] == "failed" and missing["error"] == "NATIVE_MEMORY_RUN_NOT_INSTRUMENTED"
