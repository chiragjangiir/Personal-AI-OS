+        close(reader)
+        raise OSError('controlled close failure')
+    with patch.object(SessionDB,'close',fail_after_close):
+        text=handle_pending_subcommand('memory',['reconcile',record['id']])
+    assert 'cleanup error' in text and 'check /memory pending' in text
+    assert wa.get_pending('memory',record['id']) is None
+    assert len(db._read_all('SELECT * FROM memory_effect_attempts'))==2
+
+@pytest.mark.parametrize('failure',['false','raise'])
+@pytest.mark.parametrize('target',['one','all'])
+def test_reject_receipt_separates_persisted_decision_from_cleanup(pending,failure,target):
+    home,db,record,predecessor=pending
+    def fail(*args):
+        if failure=='raise':raise OSError('controlled unlink failure')
+        return False
+    with patch.object(wa,'discard_pending',side_effect=fail):
+        text=handle_pending_subcommand('memory',['reject',record['id'] if target=='one' else 'all'])
+    assert 'Durable rejected decisions: 1' in text and 'Pending removed: 0' in text
+    assert 'rejected decision persisted' in text and '/memory reconcile '+record['id'] in text
+    assert 'could not be rejected' not in text
+    if target=='all':assert '/memory reconcile all' in text
+    source=db.read_memory_effects('run','session')['memory_receipt_source']
+    assert source['receipts'][-1]['status']=='rejected';assert wa.get_pending('memory',record['id'])
+    before=[dict(row) for row in db._read_all('SELECT * FROM memory_effect_attempts')]
+    assert 'reconciled rejected' in handle_pending_subcommand('memory',['reconcile',record['id']])
+    assert [dict(row) for row in db._read_all('SELECT * FROM memory_effect_attempts')]==before
+
+
+def test_reject_settlement_failure_never_claims_durable_rejection(pending):
+    home,db,record,predecessor=pending
+    with patch.object(SessionDB,'settle_memory_effect',side_effect=OSError('controlled settlement failure')):
+        text=handle_pending_subcommand('memory',['reject',record['id']])
+    assert 'Durable rejected decisions: 0' in text and 'native outcome unknown' in text
+    assert 'rejected decision persisted' not in text;assert wa.get_pending('memory',record['id'])
+    source=db.read_memory_effects('run','session')['memory_receipt_source'];assert len(source['unsettled_attempts'])==1
+
+
+def test_reject_existing_commit_reports_source_fact_without_new_decision(pending):
+    home,db,record,predecessor=pending;successor(db,record,predecessor,'committed')
+    before=[dict(row) for row in db._read_all('SELECT * FROM memory_effect_attempts')]
+    text=handle_pending_subcommand('memory',['reject',record['id']])
