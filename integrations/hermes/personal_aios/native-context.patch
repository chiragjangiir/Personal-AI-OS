+        root = f"/owner/out/{env._session_id}"
+        remote = tmp_path / "remote-owner-out"
+        remote.mkdir()
+        calls = []
+        # Transport seam only: execute backend shell commands in a synthetic remote namespace.
+        def execute(command, **kwargs):
+            calls.append(command)
+            result = subprocess.run(["/bin/bash", "-c", command.replace(root, str(remote))],
+                                    input=kwargs.get("stdin_data"), text=True, capture_output=True, cwd=tmp_path)
+            return {"output": result.stdout + result.stderr, "returncode": result.returncode}
+        monkeypatch.setattr(env, "execute", execute)
+        monkeypatch.setitem(terminal_tool._active_environments, task, env)
+        monkeypatch.setattr(file_tools, "_get_file_ops", lambda _task: ShellFileOperations(env))
+        result = json.loads(file_tools.write_file_tool(root + "/probe.txt", "owner result", task_id=task))
+        assert not result.get("error"), result
+        assert (remote / "probe.txt").read_text() == "owner result" and calls
+        for denied in ["/tmp/probe.txt", "/workshop/probe.txt", root + "/../escape.txt", "/owner/out/" + "0" * 32 + "/probe.txt"]:
