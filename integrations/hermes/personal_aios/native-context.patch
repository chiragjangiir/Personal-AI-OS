@@ -0,0 +1,150 @@
+"""Real native imports, private files and SQLite; no model or live service."""
+import json
+from concurrent.futures import ThreadPoolExecutor
+from contextvars import copy_context
+from pathlib import Path
+from threading import Barrier
+from types import SimpleNamespace
+
+import pytest
+
+from agent.inline_tool_executors import _memory
+from gateway.session_context import clear_session_vars, get_api_run_id, set_session_vars
+from hermes_constants import get_hermes_home
+from hermes_state import SessionDB
+from tools.memory_tool import MemoryStore
+from tools.memory_tool_outcomes import current_memory_attempt, execute_memory_effect
+
+
+@pytest.fixture
+def state():
+    home = get_hermes_home()
+    db = SessionDB(home / 'state.db')
+    db.begin_memory_effect_run('run', 'shared')
+    store = MemoryStore()
+    store.load_from_disk()
+    agent = SimpleNamespace(session_id='shared', _memory_effect_db=db,
+                            _memory_effect_incomplete=False, _memory_store=store,
+                            _memory_manager=None)
+    try:
+        yield home, db, agent
+    finally:
+        db.close()
+
+
+@pytest.mark.parametrize('platform,session,key,db_present,call_id', [
+    ('api_server', 'foreign', 'run', True, 'call'),
+    ('api_server', 'shared', '', True, 'call'),
+    ('', 'shared', 'run', True, 'call'),
+    ('', '', '', True, 'call'),
+    ('api_server', 'shared', 'run', False, 'call'),
+    ('api_server', 'shared', 'run', True, ''),
+])
+def test_instrumented_host_never_writes_without_registration(state, platform, session, key, db_present, call_id):
+    home, db, agent = state
+    if not db_present:
+        agent._memory_effect_db = None
+    tokens = set_session_vars(platform=platform, session_id=session, session_key=key)
+    try:
+        result = json.loads(_memory(agent, {'action': 'add', 'content': 'Synthetic private context test.'},
+                                    SimpleNamespace(tool_call_id=call_id)))
+        assert result['success'] is False
+        assert 'no write attempted' in result['error']
+        assert not (home / 'memories/MEMORY.md').exists()
+        assert db._read_all('SELECT * FROM memory_effect_attempts') == []
+        assert agent._memory_effect_incomplete is True
+        assert current_memory_attempt() is None
+    finally:
+        clear_session_vars(tokens)
+
+
+@pytest.mark.parametrize('platform', ['', 'api_server'])
+def test_uninstrumented_native_host_preserves_memory_store_behavior(state, platform):
+    home, db, agent = state
+    del agent._memory_effect_db
+    tokens = set_session_vars(platform=platform, session_id='shared', session_key='run')
+    try:
+        result = json.loads(_memory(agent, {'action': 'add', 'content': 'Synthetic uninstrumented host.'},
+                                    SimpleNamespace(tool_call_id='call')))
+        assert result['success'] is True and result['changed'] is True
+        assert 'Synthetic uninstrumented host.' in (home / 'memories/MEMORY.md').read_text()
+        assert db._read_all('SELECT * FROM memory_effect_attempts') == []
+        assert agent._memory_effect_incomplete is False
+    finally:
+        clear_session_vars(tokens)
+
+
+def test_registered_native_write_settles_actual_file_and_sqlite_once(state):
+    home, db, agent = state
+    tokens = set_session_vars(platform='api_server', session_id='shared', session_key='run')
+    try:
+        result = json.loads(_memory(agent, {'action': 'add', 'content': 'Synthetic registered native note.'},
+                                    SimpleNamespace(tool_call_id='call')))
+        assert result['success'] is True and result['changed'] is True
+        assert 'Synthetic registered native note.' in (home / 'memories/MEMORY.md').read_text()
+        db.finish_memory_effect_run('run')
+        source = db.read_memory_effects('run', 'shared')['memory_receipt_source']
+        assert source['status'] == 'complete' and source['unsettled_attempts'] == []
+        assert len(source['receipts']) == 1
+        receipt = source['receipts'][0]
+        assert receipt['status'] == 'committed'
+        assert receipt['summary']['tool_call_id'] == 'call'
+        before = (home / 'memories/MEMORY.md').read_bytes()
+        duplicate = json.loads(_memory(agent, {'action': 'add', 'content': 'Must never appear.'},
+                                       SimpleNamespace(tool_call_id='call')))
+        assert duplicate['success'] is False
+        assert (home / 'memories/MEMORY.md').read_bytes() == before
+        assert db.read_memory_effects('run', 'shared')['memory_receipt_source']['receipts'] == [receipt]
+        assert agent._memory_effect_incomplete is True
+    finally:
+        clear_session_vars(tokens)
+
+
+def test_concurrent_run_contexts_and_failed_effect_keep_source_identity(state):
+    home, db, _ = state
+    barrier = Barrier(2)
+    for run_id in ('success', 'interrupted'):
+        db.begin_memory_effect_run(run_id, 'shared')
+
+    def worker(run_id):
+        tokens = set_session_vars(platform='api_server', session_id='shared', session_key=run_id)
+        agent = SimpleNamespace(session_id='shared', _memory_effect_db=db, _memory_effect_incomplete=False)
+        def invoke():
+            assert current_memory_attempt()['run_id'] == run_id
+            (home / (run_id + '.txt')).write_text('Synthetic private callback effect.')
+            if run_id == 'interrupted':
+                raise RuntimeError('synthetic post-write interruption')
+            return json.dumps({'success': True, 'changed': True})
+        try:
+            barrier.wait(timeout=5)
+            if run_id == 'interrupted':
+                with pytest.raises(RuntimeError, match='post-write interruption'):
+                    execute_memory_effect(agent, {'action': 'add'}, 'call', invoke)
+            else:
+                assert json.loads(execute_memory_effect(agent, {'action': 'add'}, 'call', invoke))['success']
+            db.finish_memory_effect_run(run_id)
+            assert current_memory_attempt() is None
+        finally:
+            clear_session_vars(tokens)
+        assert get_api_run_id('shared') == ''
+
+    with ThreadPoolExecutor(max_workers=2) as pool:
+        futures = [pool.submit(copy_context().run, worker, run_id) for run_id in ('success', 'interrupted')]
+        for future in futures:
+            future.result(timeout=15)
+    success = db.read_memory_effects('success', 'shared')['memory_receipt_source']
+    failed = db.read_memory_effects('interrupted', 'shared')['memory_receipt_source']
+    assert success['status'] == 'complete'
+    assert success['receipts'][0]['summary']['run_id'] == 'success'
+    assert failed['status'] == 'partial' and failed['receipts'] == []
+    assert failed['unsettled_attempts'][0]['run_id'] == 'interrupted'
+    assert (home / 'interrupted.txt').is_file()
+
+
+def test_imports_use_candidate_sources():
+    import gateway.session_context
+    import hermes_state_memory_outcomes
+    import tools.memory_tool_outcomes
+    root = Path(__file__).parent.parent
+    for module in (gateway.session_context, hermes_state_memory_outcomes, tools.memory_tool_outcomes):
+        assert Path(module.__file__).resolve().is_relative_to(root)
