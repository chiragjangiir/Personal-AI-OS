+from hermes_constants import set_hermes_home_override, reset_hermes_home_override
+from hermes_state import SessionDB
+from tools import write_approval as wa
+from tools import memory_tool_outcomes as outcomes
+from tools.memory_tool import MemoryStore
+from hermes_cli.write_approval_commands import handle_pending_subcommand
+
+@pytest.fixture
+def pending(tmp_path):
+    home=tmp_path/'profile';home.mkdir();token=set_hermes_home_override(home)
+    db=SessionDB(home/'state.db');db.begin_memory_effect_run('run','session')
+    ref=db.begin_memory_effect('run','session','call','add','memory')
+    identity={'attempt_ref':ref,'run_id':'run','session_id':'session','tool_call_id':'call','profile_home':str(home)}
+    attempt=outcomes._current_attempt.set(identity)
+    try:record=wa.stage_write('memory',{'action':'add','target':'memory','content':'Synthetic pending.'},summary='Synthetic',origin='foreground')
+    finally:outcomes._current_attempt.reset(attempt)
+    predecessor=db.settle_memory_effect(ref,'pending_approval',record['id']);db.finish_memory_effect_run('run')
+    yield home,db,record,predecessor
+    db.close();reset_hermes_home_override(token)
+
+def successor(db,record,predecessor,status):
+    ref=db.begin_memory_effect('run','session','call:resolve:'+record['id'],'reject' if status=='rejected' else 'add','memory',predecessor_ref=predecessor,pending_id=record['id'])
+    if status!='unknown':db.settle_memory_effect(ref,status,record['id'])
+    return ref
+
+@pytest.mark.parametrize('status',['committed','unchanged','rejected'])
+def test_reconcile_terminal_successor_only_cleans_pending(pending,status):
+    home,db,record,predecessor=pending;successor(db,record,predecessor,status)
+    before=[dict(row) for row in db._read_all('SELECT * FROM memory_effect_attempts')]
+    with patch.object(SessionDB,'begin_memory_effect',side_effect=AssertionError('attempt replay')), patch.object(MemoryStore,'_mutate',side_effect=AssertionError('writer replay')):
+        text=handle_pending_subcommand('memory',['reconcile',record['id']])
+    assert f'reconciled {status}' in text and 'no new write' in text
+    assert wa.get_pending('memory',record['id']) is None
+    assert [dict(row) for row in db._read_all('SELECT * FROM memory_effect_attempts')]==before
+    assert 'No matching' in handle_pending_subcommand('memory',['reconcile',record['id']])
+    assert not (home/'memories/MEMORY.md').exists();assert not (home/'memories/USER.md').exists()
+
+@pytest.mark.parametrize('status',[None,'unknown','failed'])
+def test_missing_unknown_failed_retains_pending_without_attempt(pending,status):
+    home,db,record,predecessor=pending
+    if status:successor(db,record,predecessor,status)
+    before=[dict(row) for row in db._read_all('SELECT * FROM memory_effect_attempts')]
+    with patch.object(SessionDB,'begin_memory_effect',side_effect=AssertionError('attempt replay')), patch.object(MemoryStore,'_mutate',side_effect=AssertionError('writer replay')):
+        text=handle_pending_subcommand('memory',['reconcile',record['id']])
+    assert 'retained' in text;assert wa.get_pending('memory',record['id'])
+    assert [dict(row) for row in db._read_all('SELECT * FROM memory_effect_attempts')]==before
+
+@pytest.mark.parametrize('field',['run_id','session_id','tool_call_id','attempt_ref','profile_home','id','action','target','subsystem'])
+def test_reconcile_rejects_foreign_or_tampered_binding(pending,field):
+    home,db,record,predecessor=pending;successor(db,record,predecessor,'committed');bad=copy.deepcopy(record)
+    if field in ('run_id','session_id','tool_call_id','attempt_ref','profile_home'):bad['memory_effect'][field]='foreign'
+    elif field in ('action','target'):bad['payload'][field]='foreign'
+    else:bad[field]='foreign'
+    assert not outcomes.reconcile_pending_memory(bad)['success']
+    assert wa.get_pending('memory',record['id'])
+
+@pytest.mark.parametrize('column,value',[('predecessor_ref',None),('tool_call_id','foreign'),('pending_id','foreign'),('operation','foreign')])
+def test_source_successor_corruption_cannot_delete_pending(pending,column,value):
+    home,db,record,predecessor=pending;ref=successor(db,record,predecessor,'committed')
+    db._execute_write(lambda connection:connection.execute(f'UPDATE memory_effect_attempts SET {column}=? WHERE attempt_ref=?',(value,ref)))
+    assert 'retained' in handle_pending_subcommand('memory',['reconcile',record['id']])
+    assert wa.get_pending('memory',record['id'])
+
+def test_reconcile_all_keeps_legacy_and_cleans_only_known_native(pending):
