+@pytest.mark.asyncio
+@pytest.mark.parametrize('kind', ['tool', 'approval'])
+@pytest.mark.parametrize('state', ['running', 'stopping', 'completed', 'interrupted', 'forgotten'])
+async def test_worker_publication_is_owned_by_original_loop(kind, state):
+    from types import SimpleNamespace
+    adapter = _make_adapter()
+    loop = asyncio.get_running_loop()
+    queue = adapter._run_streams['fixture'] = asyncio.Queue()
+    adapter._set_run_status('fixture', 'running')
+    run = SimpleNamespace(run_id='fixture', queue=queue,
+        put_event=lambda event: queue.put_nowait(event) if adapter._run_streams.get('fixture') is queue else None)
+    callback = (adapter._make_run_event_callback('fixture', loop) if kind == 'tool'
+        else api_server_runs._make_approval_notify(adapter, run, _api_server=api_server))
+    scheduled, finish = threading.Event(), threading.Event()
+    def publish():
+        if kind == 'tool': callback('tool.started', 'fixture-tool')
+        else: callback({'request_id':'fixture-exact-approval', 'command':'fixture-command'})
+        scheduled.set()
+        finish.wait(3)
+    worker = threading.Thread(target=publish)
+    worker.start()
+    try:
+        # Do not yield: worker may enqueue but must never mutate loop-owned status.
+        assert scheduled.wait(3)
+        assert adapter._run_statuses['fixture']['status'] == 'running'
+        assert 'last_event' not in adapter._run_statuses['fixture']
+        if state == 'forgotten':
+            adapter._run_statuses.pop('fixture')
+            adapter._run_streams.pop('fixture')
+        else:
+            adapter._set_run_status('fixture', state)
+        await asyncio.sleep(0)
+        if state == 'forgotten':
+            assert 'fixture' not in adapter._run_statuses
+            assert queue.empty()
+        else:
+            expected = 'waiting_for_approval' if kind == 'approval' and state == 'running' else state
+            assert adapter._run_statuses['fixture']['status'] == expected
+            assert queue.empty() == (state in {'completed', 'interrupted'} or (kind == 'approval' and state == 'stopping'))
+        if kind == 'approval' and state == 'running':
+            api_server_runs._mark_run_event(adapter, 'fixture', 'approval.responded', request_id='fixture-exact-approval', resolved=1)
+            assert adapter._run_statuses['fixture']['status'] == 'running'
+            assert [queue.get_nowait()['event'], queue.get_nowait()['event']] == ['approval.request', 'approval.responded']
+    finally:
+        finish.set(); worker.join(3)
+        assert not worker.is_alive()
+        adapter._run_idempotency_store.close()
+
+
+@pytest.mark.parametrize('kind', ['tool', 'approval'])
+def test_closed_original_loop_publication_is_visible_failure(kind):
+    from types import SimpleNamespace
+    adapter = _make_adapter()
+    loop = asyncio.new_event_loop()
+    queue = adapter._run_streams['fixture'] = asyncio.Queue()
+    adapter._set_run_status('fixture', 'running')
+    async def create_callback():
+        run = SimpleNamespace(run_id='fixture', queue=queue, put_event=queue.put_nowait)
+        return (adapter._make_run_event_callback('fixture', loop) if kind == 'tool'
+            else api_server_runs._make_approval_notify(adapter, run, _api_server=api_server))
+    callback = loop.run_until_complete(create_callback())
+    loop.close()
+    try:
