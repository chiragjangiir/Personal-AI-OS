+def test_request_fields_are_validated_and_restricted_scopes_never_write_memory():
+    assert run_scope.run_scope_request({"input": "x"}, None) == ("owner", None)
+    assert run_scope.run_scope_request({"session_id": "s", "run_scope": "guest", "guest_key": "speaker:12:2026-10-09"}, False) == \
+        ("guest", "speaker:12:2026-10-09")
+    assert run_scope.run_scope_request({"session_id": "s", "run_scope": "owner_uncertain"}, False) == ("owner_uncertain", None)
+    for body, memory_write in [({"session_id": "s", "run_scope": "admin"}, False),
+                               ({"session_id": "s", "run_scope": "guest"}, False),
+                               ({"session_id": "s", "run_scope": "owner_uncertain", "guest_key": "k"}, False),
+                               ({"session_id": "s", "run_scope": "guest", "guest_key": "../owner"}, False),
+                               ({"session_id": "s", "run_scope": "owner_uncertain"}, True),
+                               ({"run_scope": "owner_uncertain"}, False),
+                               ({"session_id": "s", "run_scope": "guest", "guest_key": "k", "conversation_history": [{"role": "user", "content": "x"}]}, False),
+                               ({"session_id": "s", "run_scope": "guest", "guest_key": "k", "previous_response_id": "resp"}, False)]:
+        with pytest.raises(ValueError):
+            run_scope.run_scope_request(body, memory_write)
+    guest = run_scope.guest_session_id("owner-session", "speaker:12:2026-10-09")
+    assert guest.startswith("paios-guest-") and guest != "owner-session"
+    assert guest == run_scope.guest_session_id("owner-session", "speaker:12:2026-10-09")
+    assert guest != run_scope.guest_session_id("owner-session", "speaker:12:2026-10-10")
+
