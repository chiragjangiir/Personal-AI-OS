+@pytest.mark.asyncio
+async def test_loop_publication_failure_reaches_loop_exception_handler(monkeypatch):
+    adapter = _make_adapter()
+    loop = asyncio.get_running_loop()
+    errors, seen = [], asyncio.Event()
+    previous = loop.get_exception_handler()
+    def record(owner, context):
+        errors.append(context['exception']); seen.set()
+    loop.set_exception_handler(record)
+    adapter._set_run_status('fixture', 'running')
+    callback = adapter._make_run_event_callback('fixture', loop)
+    def fail(*a, **k): raise OSError('fixture status publication failed')
+    monkeypatch.setattr(adapter, '_set_run_status', fail)
+    try:
+        await asyncio.to_thread(callback, 'tool.started', 'fixture-tool')
+        await asyncio.wait_for(seen.wait(), 3)
+        assert len(errors) == 1 and str(errors[0]) == 'fixture status publication failed'
+    finally:
+        loop.set_exception_handler(previous)
+        adapter._run_idempotency_store.close()
