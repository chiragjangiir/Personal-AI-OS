{
  "version": 2,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "at": {
      "type": "string",
      "format": "paios-utc"
    },
    "avatar_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "look_id",
        "style",
        "image_url",
        "focus",
        "updated_at"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "look_id": {
          "$ref": "#/$defs/id"
        },
        "style": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "image_url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048
        },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "updated_at": {
          "$ref": "#/$defs/at"
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quote_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "price_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scope_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "quote_id",
        "price_text",
        "scope_text"
      ]
    },
    "look": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "look_id": {
          "$ref": "#/$defs/id"
        },
        "style": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "image_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "required": [
        "look_id",
        "style",
        "image_url",
        "focus"
      ]
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_id",
        "status",
        "profile"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "ready",
            "pending",
            "failed",
            "submission_uncertain",
            "superseded",
            "cancelled"
          ]
        },
        "profile": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/avatar_profile"
            }
          ]
        },
        "error": {
          "type": "string",
          "maxLength": 1000
        },
        "profile_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "inputs": {
    "avatar_options": {
      "definition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "const": "avatar_options"
          },
          "request_id": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "operation",
          "request_id"
        ]
      },
      "error": "AVATAR_APPEARANCE_ARGUMENT_INVALID"
    },
    "avatar_prepare": {
      "definition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "const": "avatar_prepare"
          },
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "command_id": {
            "$ref": "#/$defs/id"
          },
          "look_id": {
            "$ref": "#/$defs/id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0
          },
          "quote_id": {
            "$ref": "#/$defs/id"
          },
          "owner_request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "focus": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "confirmed_quote": {
            "$ref": "#/$defs/quote"
          }
        },
        "required": [
          "operation",
          "request_id",
          "command_id",
          "look_id",
          "expected_version",
          "quote_id",
          "owner_request",
          "focus",
          "confirmed_quote"
        ]
      },
      "error": "AVATAR_APPEARANCE_ARGUMENT_INVALID"
    },
    "avatar_reconcile": {
      "definition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "const": "avatar_reconcile"
          },
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "command_id": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "operation",
          "request_id",
          "command_id"
        ]
      },
      "error": "AVATAR_APPEARANCE_ARGUMENT_INVALID"
    },
    "avatar_cancel": {
      "definition": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operation": {
            "const": "avatar_cancel"
          },
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "command_id": {
            "$ref": "#/$defs/id"
          }
        },
        "required": [
          "operation",
          "request_id",
          "command_id"
        ]
      },
      "error": "AVATAR_APPEARANCE_ARGUMENT_INVALID"
    },
    "avatar_reuse": {
      "definition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "request_id",
          "command_id",
          "expected_version",
          "version",
          "owner_request"
        ],
        "properties": {
          "operation": {
            "const": "avatar_reuse"
          },
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "command_id": {
            "$ref": "#/$defs/id"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "owner_request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "error": "AVATAR_APPEARANCE_ARGUMENT_INVALID"
    }
  },
  "outputs": {
    "avatar_options_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "paios.central.text-envelope.v1"
        },
        "operation": {
          "const": "avatar_options_state"
        },
        "session_id": {
          "$ref": "#/$defs/id"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "looks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/look"
          }
        },
        "preparation_quote": {
          "$ref": "#/$defs/quote"
        },
        "call_quote": {
          "$ref": "#/$defs/quote"
        },
        "unavailable_reason": {
          "type": "string",
          "maxLength": 1000
        },
        "photo_upload_available": {
          "type": "boolean"
        },
        "current_preparation": {
          "$ref": "#/$defs/preparation"
        },
        "current_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recent_versions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "profile"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "profile": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/avatar_profile"
                  }
                ]
              }
            }
          }
        }
      },
      "required": [
        "schema_version",
        "operation",
        "session_id",
        "request_id",
        "looks",
        "photo_upload_available"
      ]
    },
    "avatar_preparation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "paios.central.text-envelope.v1"
        },
        "operation": {
          "const": "avatar_preparation"
        },
        "session_id": {
          "$ref": "#/$defs/id"
        },
        "request_id": {
          "$ref": "#/$defs/id"
        },
        "command_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "ready",
            "pending",
            "failed",
            "submission_uncertain",
            "superseded",
            "cancelled"
          ]
        },
        "profile": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/avatar_profile"
            }
          ]
        },
        "error": {
          "type": "string",
          "maxLength": 1000
        },
        "profile_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "operation",
        "session_id",
        "request_id",
        "command_id",
        "status",
        "profile"
      ]
    }
  }
}
