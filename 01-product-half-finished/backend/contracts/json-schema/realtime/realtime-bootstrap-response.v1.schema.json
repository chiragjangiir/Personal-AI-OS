{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/contracts/realtime/realtime-bootstrap-response.v1.schema.json",
  "title": "RealtimeBootstrapResponse",
  "$comment": "Successful bootstrap response. Errors use realtime-terminal-result.",
  "type": "object",
  "required": [
    "operation",
    "bootstrap_mode",
    "status",
    "request_id",
    "realtime_session_ref",
    "device_lease_ref",
    "continuity_id",
    "transport_aliases",
    "connection_epoch",
    "livekit",
    "media_grants",
    "e2ee_key_envelope",
    "governance",
    "recipient_device_credential_ref"
  ],
  "properties": {
    "canonical_api_origin": { "type": "string", "format": "uri", "pattern": "^https://[^/?#@]+$", "maxLength": 253 },
    "operation": { "const": "bootstrap" },
    "bootstrap_mode": {
      "type": "string",
      "enum": ["initial", "fully_disconnected"]
    },
    "status": { "const": "bootstrap_accepted" },
    "request_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/IdempotencyKey"
    },
    "realtime_session_ref": {
      "$ref": "https://personal-ai-os.local/contracts/common/versioning-hash.v1.schema.json#/$defs/CanonicalObjectVersionRef"
    },
    "device_lease_ref": {
      "$ref": "https://personal-ai-os.local/contracts/common/versioning-hash.v1.schema.json#/$defs/CanonicalObjectVersionRef"
    },
    "continuity_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ContinuityId"
    },
    "transport_aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ExternalAlias"
      }
    },
    "connection_epoch": { "$ref": "#/$defs/ConnectionEpoch" },
    "livekit": { "$ref": "#/$defs/LiveKitCredential" },
    "media_grants": { "$ref": "#/$defs/MediaGrants" },
    "e2ee_key_envelope": {
      "$ref": "https://personal-ai-os.local/contracts/realtime/realtime-e2ee-key-envelope.v1.schema.json"
    },
    "governance": { "$ref": "#/$defs/GovernanceRefs" },
    "central_text_transport": { "$ref": "https://personal-ai-os.local/contracts/formal-message.v1.json#/$defs/bootstrap" },
    "recipient_device_credential_ref": { "$ref": "#/$defs/RecipientDeviceCredentialRef" }
  },
  "additionalProperties": false,
  "$defs": {
    "ConnectionEpoch": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,37}$"
    },
    "LiveKitCredential": {
      "type": "object",
      "required": ["server_url", "participant_token", "credential_expires_at"],
      "properties": {
        "server_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^wss://[^\\s]+$"
        },
        "participant_token": { "type": "string", "minLength": 1 },
        "credential_expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "StartBinding": {
      "type": "object",
      "required": ["kind", "device_id", "modalities"],
      "properties": {
        "kind": { "const": "explicit_user_start" },
        "device_id": {
          "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/DeviceId"
        },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["audio", "video", "data"] }
        }
      },
      "additionalProperties": false
    },
    "MediaGrant": {
      "oneOf": [
        {
          "type": "object",
          "required": ["enabled", "device_id", "device_lease_ref", "start_binding", "expires_at"],
          "properties": {
            "enabled": { "const": true },
            "device_id": {
              "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/DeviceId"
            },
            "device_lease_ref": {
              "$ref": "https://personal-ai-os.local/contracts/common/versioning-hash.v1.schema.json#/$defs/CanonicalObjectVersionRef"
            },
            "start_binding": { "$ref": "#/$defs/StartBinding" },
            "expires_at": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["enabled"],
          "properties": { "enabled": { "const": false } },
          "additionalProperties": false
        }
      ]
    },
    "MediaGrants": {
      "type": "object",
      "required": ["audio", "video", "data"],
      "properties": {
        "audio": { "$ref": "#/$defs/MediaGrant" },
        "video": { "$ref": "#/$defs/MediaGrant" },
        "data": { "$ref": "#/$defs/MediaGrant" }
      },
      "additionalProperties": false
    },
    "GovernanceRefs": {
      "type": "object",
      "required": ["purpose_scopes", "policy_decision_refs", "capability_grant_refs"],
      "properties": {
        "purpose_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/PurposeScope"
          }
        },
        "consent_record_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ConsentRecordId"
          }
        },
        "policy_decision_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PolicyDecisionId"
          }
        },
        "purpose_token_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PurposeTokenId"
          }
        },
        "capability_grant_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/CapabilityGrantId"
          }
        },
        "audit_ref": {
          "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/AuditReference"
        }
      },
      "additionalProperties": false
    },
    "RecipientDeviceCredentialRef": {
      "allOf": [
        { "$ref": "https://personal-ai-os.local/contracts/common/versioning-hash.v1.schema.json#/$defs/CanonicalObjectVersionRef" },
        { "properties": { "ref_type": { "const": "DeviceCredential" } }, "required": ["ref_type"] }
      ]
    }
  }
}
