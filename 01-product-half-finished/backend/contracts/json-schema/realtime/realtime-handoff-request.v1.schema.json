{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/contracts/realtime/realtime-handoff-request.v1.schema.json",
  "title": "RealtimeSessionHandoffRequest",
  "$comment": "Handoff keeps the RealtimeSession, continuity_id, and connection_epoch. Runtime admission must verify the from device is the active lease owner, compare expected_lease_version with a CAS, reject replay or binding drift, release the old lease, and create the new active lease atomically.",
  "type": "object",
  "required": [
    "operation",
    "request_id",
    "idempotency_context",
    "realtime_session_ref",
    "current_device_lease_ref",
    "continuity_id",
    "connection_epoch",
    "expected_lease_version",
    "from_device_id",
    "to_device_id",
    "governance"
  ],
  "properties": {
    "operation": { "const": "handoff" },
    "request_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/IdempotencyKey"
    },
    "idempotency_context": {
      "$ref": "https://personal-ai-os.local/contracts/common/idempotency-replay.v1.schema.json#/$defs/IdempotencyContext"
    },
    "realtime_session_ref": {
      "allOf": [
        {
          "$ref": "https://personal-ai-os.local/contracts/common/versioning-hash.v1.schema.json#/$defs/CanonicalObjectVersionRef"
        },
        {
          "properties": {
            "ref_type": { "const": "RealtimeSession" }
          }
        }
      ]
    },
    "current_device_lease_ref": {
      "allOf": [
        {
          "$ref": "https://personal-ai-os.local/contracts/common/versioning-hash.v1.schema.json#/$defs/CanonicalObjectVersionRef"
        },
        {
          "properties": {
            "ref_type": { "const": "DeviceLease" }
          }
        }
      ]
    },
    "continuity_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ContinuityId"
    },
    "connection_epoch": { "$ref": "#/$defs/PositiveDecimal" },
    "expected_lease_version": { "$ref": "#/$defs/PositiveDecimal" },
    "from_device_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/DeviceId"
    },
    "to_device_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/DeviceId"
    },
    "governance": { "$ref": "#/$defs/GovernanceRefs" }
  },
  "additionalProperties": false,
  "$defs": {
    "PositiveDecimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,37}$"
    },
    "GovernanceRefs": {
      "type": "object",
      "required": [
        "purpose_scopes",
        "policy_decision_refs",
        "capability_grant_refs"
      ],
      "properties": {
        "purpose_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/PurposeScope"
          }
        },
        "consent_record_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ConsentRecordId"
          }
        },
        "policy_decision_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PolicyDecisionId"
          }
        },
        "purpose_token_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PurposeTokenId"
          }
        },
        "capability_grant_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/CapabilityGrantId"
          }
        },
        "audit_ref": {
          "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/AuditReference"
        }
      },
      "additionalProperties": false
    }
  }
}
