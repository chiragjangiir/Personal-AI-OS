{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/contracts/realtime/realtime-bootstrap-request.v1.schema.json",
  "title": "RealtimeBootstrapRequest",
  "$comment": "Successor control-plane request. It is an operation payload, not a new canonical object type.",
  "type": "object",
  "required": [
    "operation",
    "bootstrap_mode",
    "request_id",
    "idempotency_context",
    "device_id",
    "start",
    "requested_media",
    "governance"
  ],
  "properties": {
    "operation": { "const": "bootstrap" },
    "bootstrap_mode": {
      "type": "string",
      "enum": ["initial", "fully_disconnected"]
    },
    "request_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/IdempotencyKey"
    },
    "idempotency_context": {
      "$ref": "https://personal-ai-os.local/contracts/common/idempotency-replay.v1.schema.json#/$defs/IdempotencyContext"
    },
    "device_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/DeviceId"
    },
    "continuity_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ContinuityId"
    },
    "transport_aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ExternalAlias"
      }
    },
    "start": { "$ref": "#/$defs/ExplicitStart" },
    "requested_media": { "$ref": "#/$defs/RequestedMedia" },
    "governance": { "$ref": "#/$defs/GovernanceRefs" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "bootstrap_mode": { "const": "fully_disconnected" } },
        "required": ["bootstrap_mode"]
      },
      "then": { "required": ["continuity_id"] }
    },
    {
      "if": {
        "properties": { "bootstrap_mode": { "const": "initial" } },
        "required": ["bootstrap_mode"]
      },
      "then": { "not": { "required": ["continuity_id"] } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "ExplicitStart": {
      "type": "object",
      "required": ["kind", "device_id", "modalities", "started_at"],
      "properties": {
        "kind": { "const": "explicit_user_start" },
        "device_id": {
          "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/DeviceId"
        },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["audio", "video", "data"] }
        },
        "started_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "RequestedMedia": {
      "type": "object",
      "required": ["audio", "video", "data"],
      "properties": {
        "audio": { "type": "boolean" },
        "video": { "type": "boolean" },
        "data": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "GovernanceRefs": {
      "type": "object",
      "required": ["purpose_scopes", "policy_decision_refs", "capability_grant_refs"],
      "properties": {
        "purpose_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/PurposeScope"
          }
        },
        "consent_record_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ConsentRecordId"
          }
        },
        "policy_decision_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PolicyDecisionId"
          }
        },
        "purpose_token_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PurposeTokenId"
          }
        },
        "capability_grant_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/CapabilityGrantId"
          }
        },
        "audit_ref": {
          "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/AuditReference"
        }
      },
      "additionalProperties": false
    }
  }
}
