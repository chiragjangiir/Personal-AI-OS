{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/contracts/realtime/realtime-credential-refresh-response.v1.schema.json",
  "title": "RealtimeConnectedCredentialRefreshResponse",
  "$comment": "The same session, lease and epoch receive a new short-lived transport credential.",
  "type": "object",
  "required": [
    "operation",
    "status",
    "request_id",
    "realtime_session_ref",
    "device_lease_ref",
    "continuity_id",
    "transport_aliases",
    "connection_epoch",
    "transport_credential",
    "governance"
  ],
  "properties": {
    "operation": { "const": "connected_credential_refresh" },
    "status": { "const": "credential_refreshed" },
    "request_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/IdempotencyKey"
    },
    "realtime_session_ref": {
      "$ref": "https://personal-ai-os.local/contracts/common/versioning-hash.v1.schema.json#/$defs/CanonicalObjectVersionRef"
    },
    "device_lease_ref": {
      "$ref": "https://personal-ai-os.local/contracts/common/versioning-hash.v1.schema.json#/$defs/CanonicalObjectVersionRef"
    },
    "continuity_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ContinuityId"
    },
    "transport_aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ExternalAlias"
      }
    },
    "connection_epoch": { "$ref": "#/$defs/ConnectionEpoch" },
    "transport_credential": { "$ref": "#/$defs/TransportCredential" },
    "call_rejoin": {
      "description": "Current call transport-loss window. The first qualified absolute deadline may replace the client loss-time estimate. For the same call and loss, later replies must not extend the accepted deadline; an earlier deadline may shorten it. A client records extensions as contract violations but still uses the fresh credential. Reset the budget only after confirmed encrypted/ready recovery.",
      "type": "object", "additionalProperties": false, "required": ["call_id", "rejoin_deadline"],
      "properties": {
        "call_id": {"$ref": "https://personal-ai-os.local/contracts/formal-message.v1.json#/inputs/call_open/definition/properties/call_id"},
        "rejoin_deadline": {"$ref": "https://personal-ai-os.local/contracts/formal-message.v1.json#/outputs/call_state/properties/rejoin_deadline"}
      }
    },
    "governance": { "$ref": "#/$defs/GovernanceRefs" }
  },
  "additionalProperties": false,
  "$defs": {
    "ConnectionEpoch": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,37}$"
    },
    "TransportCredential": {
      "type": "object",
      "required": ["credential", "expires_at", "credential_generation"],
      "properties": {
        "credential": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "credential_generation": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,37}$"
        }
      },
      "additionalProperties": false
    },
    "GovernanceRefs": {
      "type": "object",
      "required": ["purpose_scopes", "policy_decision_refs", "capability_grant_refs"],
      "properties": {
        "purpose_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/PurposeScope"
          }
        },
        "consent_record_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ConsentRecordId"
          }
        },
        "policy_decision_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PolicyDecisionId"
          }
        },
        "purpose_token_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PurposeTokenId"
          }
        },
        "capability_grant_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/CapabilityGrantId"
          }
        },
        "audit_ref": {
          "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/AuditReference"
        }
      },
      "additionalProperties": false
    }
  }
}
