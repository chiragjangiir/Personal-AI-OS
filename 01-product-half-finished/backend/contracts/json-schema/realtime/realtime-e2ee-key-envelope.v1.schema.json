{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/contracts/realtime/realtime-e2ee-key-envelope.v1.schema.json",
  "title": "RealtimeE2eeKeyEnvelope",
  "$comment": "Reference-only key envelope. Plaintext key material is intentionally not representable.",
  "type": "object",
  "required": [
    "key_envelope_ref",
    "key_index",
    "key_generation",
    "expires_at",
    "scope",
    "realtime_session_ref",
    "continuity_id",
    "governance"
  ],
  "properties": {
    "key_envelope_ref": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ExternalAlias"
    },
    "key_index": {
      "type": "integer",
      "minimum": 0
    },
    "key_generation": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,37}$"
    },
    "expires_at": { "type": "string", "format": "date-time" },
    "scope": { "$ref": "#/$defs/KeyScope" },
    "realtime_session_ref": {
      "$ref": "https://personal-ai-os.local/contracts/common/versioning-hash.v1.schema.json#/$defs/CanonicalObjectVersionRef"
    },
    "continuity_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ContinuityId"
    },
    "governance": { "$ref": "#/$defs/GovernanceRefs" }
  },
  "additionalProperties": false,
  "$defs": {
    "KeyScope": {
      "type": "object",
      "required": ["device_id", "channels", "distribution_mode"],
      "properties": {
        "device_id": {
          "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/DeviceId"
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["audio", "video", "data"] }
        },
        "distribution_mode": { "const": "application_controlled_envelope" }
      },
      "additionalProperties": false
    },
    "GovernanceRefs": {
      "type": "object",
      "required": ["purpose_scopes", "policy_decision_refs", "capability_grant_refs"],
      "properties": {
        "purpose_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/PurposeScope"
          }
        },
        "consent_record_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ConsentRecordId"
          }
        },
        "policy_decision_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PolicyDecisionId"
          }
        },
        "purpose_token_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PurposeTokenId"
          }
        },
        "capability_grant_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/CapabilityGrantId"
          }
        },
        "audit_ref": {
          "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/AuditReference"
        }
      },
      "additionalProperties": false
    }
  }
}
