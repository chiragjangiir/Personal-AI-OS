{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/contracts/realtime/realtime-credential-refresh-request.v1.schema.json",
  "title": "RealtimeConnectedCredentialRefreshRequest",
  "$comment": "Connected-room credential refresh. It never renews continuity or connection_epoch.",
  "type": "object",
  "required": [
    "operation",
    "request_id",
    "idempotency_context",
    "realtime_session_ref",
    "device_lease_ref",
    "continuity_id",
    "connection_epoch",
    "refresh_reason",
    "governance"
  ],
  "properties": {
    "operation": { "const": "connected_credential_refresh" },
    "request_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/IdempotencyKey"
    },
    "idempotency_context": {
      "$ref": "https://personal-ai-os.local/contracts/common/idempotency-replay.v1.schema.json#/$defs/IdempotencyContext"
    },
    "realtime_session_ref": {
      "$ref": "https://personal-ai-os.local/contracts/common/versioning-hash.v1.schema.json#/$defs/CanonicalObjectVersionRef"
    },
    "device_lease_ref": {
      "$ref": "https://personal-ai-os.local/contracts/common/versioning-hash.v1.schema.json#/$defs/CanonicalObjectVersionRef"
    },
    "continuity_id": {
      "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ContinuityId"
    },
    "transport_aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ExternalAlias"
      }
    },
    "connection_epoch": { "$ref": "#/$defs/ConnectionEpoch" },
    "refresh_reason": {
      "type": "string",
      "enum": ["credential_expiring", "sdk_reconnect", "server_refresh"]
    },
    "governance": { "$ref": "#/$defs/GovernanceRefs" }
  },
  "additionalProperties": false,
  "$defs": {
    "ConnectionEpoch": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,37}$"
    },
    "GovernanceRefs": {
      "type": "object",
      "required": ["purpose_scopes", "policy_decision_refs", "capability_grant_refs"],
      "properties": {
        "purpose_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/PurposeScope"
          }
        },
        "consent_record_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/ConsentRecordId"
          }
        },
        "policy_decision_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PolicyDecisionId"
          }
        },
        "purpose_token_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/PurposeTokenId"
          }
        },
        "capability_grant_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/CapabilityGrantId"
          }
        },
        "audit_ref": {
          "$ref": "https://personal-ai-os.local/contracts/common/governance-context.v1.schema.json#/$defs/AuditReference"
        }
      },
      "additionalProperties": false
    }
  }
}
