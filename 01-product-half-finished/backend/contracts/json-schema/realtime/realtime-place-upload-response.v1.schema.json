{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/contracts/realtime/realtime-place-upload-response.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stored_ids",
    "duplicate_ids",
    "expired_ids",
    "regions"
  ],
  "properties": {
    "schema": {
      "const": "paios.place-upload-response.v1"
    },
    "stored_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "duplicate_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "expired_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "maxItems": 18,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "latitude",
              "longitude",
              "radius_m"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "radius_m": {
                "type": "number",
                "minimum": 1,
                "maximum": 1000
              }
            }
          }
        }
      }
    }
  }
}
