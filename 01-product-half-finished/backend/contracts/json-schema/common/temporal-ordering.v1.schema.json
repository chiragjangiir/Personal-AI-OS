{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/contracts/common/temporal-ordering.v1.schema.json",
  "title": "CanonicalTemporalOrdering",
  "$comment": "schema_version=1.0.0",
  "not": {},
  "$defs": {
    "SystemTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{6}Z$"
    },
    "EvidenceTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{3}|\\.[0-9]{6})?Z$"
    },
    "EventTimeStatus": {
      "type": "string",
      "enum": ["known", "unknown"]
    },
    "EventTimePrecision": {
      "type": "string",
      "enum": ["second", "millisecond", "microsecond"]
    },
    "EventTimeSource": {
      "type": "string",
      "enum": ["source", "user_asserted", "producer_clock"]
    },
    "ClockSkewStatus": {
      "type": "string",
      "enum": ["within_tolerance", "suspect", "not_applicable"]
    },
    "ReplayPartition": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "ReplayPosition": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37})$"
    },
    "ReplayTieBreaker": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37})$",
      "not": {
        "$ref": "https://personal-ai-os.local/contracts/common/id-types.v1.schema.json#/$defs/EventId"
      }
    }
  }
}
