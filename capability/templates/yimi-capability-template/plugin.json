{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "yimi-capability-template",
  "version": "0.1.0",
  "description": "Replace the sample tool with one reusable capability",
  "extensions": {
    "ai.yimi.capability": {
      "schema": "yimi.capability.v1",
      "receipt_schema": 1,
      "compat": {"hermes": ">=0.22.5 <0.24", "gateway_api": 1},
      "maintainer": "yimi",
      "runtime": {"server": "capability", "lazy": true, "idle_timeout_seconds": 900, "host": "shared"},
      "secrets": [],
      "network": {"egress": []},
      "scopes": ["owner"],
      "tools": {"sample": {"effect": "observe", "retry": "forbidden"}},
      "staging": {"fake": {"command": "python3", "args": ["fake/server.py"]}},
      "tests": {"contract": "tests/contract.yaml"},
      "provenance": {"source_commit": "decaff83", "workshop_run": null, "adapter_modules": ["server/server.py"]}
    }
  }
}
