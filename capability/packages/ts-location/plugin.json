{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ts-location",
  "version": "1.0.0",
  "description": "位置历史、围栏、骑行、导航及显式感知",
  "extensions": {
    "ai.yimi.capability": {
      "schema": "yimi.capability.v1",
      "receipt_schema": 1,
      "compat": {
        "hermes": ">=0.22.5 <0.24",
        "gateway_api": 1
      },
      "maintainer": "lead",
      "runtime": {
        "server": "platform_ts",
        "lazy": true,
        "idle_timeout_seconds": 900,
        "host": "shared"
      },
      "secrets": [
        {
          "name": "HERMES_INTERNAL_KEY"
        }
      ],
      "network": {
        "egress": []
      },
      "scopes": [
        "owner"
      ],
      "tools": {
        "paios_place_history": {
          "effect": "observe",
          "retry": "forbidden",
          "check_with": "paios_place_history",
          "context_inject": [
            "_context"
          ],
          "task_type": "platform:place_history"
        },
        "paios_geofences": {
          "effect_by_arg": {
            "$.action": {
              "list": "observe",
              "set": "owner_data",
              "remove": "owner_data"
            }
          },
          "retry": "forbidden",
          "check_with": "paios_geofences",
          "context_inject": [
            "_context"
          ],
          "task_type": "platform:geofences",
          "target": "$.region_id"
        },
        "paios_ride": {
          "effect_by_arg": {
            "$.action": {
              "status": "observe",
              "start": "owner_data",
              "stop": "owner_data"
            }
          },
          "retry": "forbidden",
          "check_with": "paios_ride",
          "context_inject": [
            "_context"
          ],
          "task_type": "platform:ride"
        },
        "paios_navigate": {
          "effect": "owner_data",
          "retry": "forbidden",
          "check_with": "paios_ride",
          "context_inject": [
            "_context"
          ],
          "task_type": "platform:navigate",
          "target": "$.destination"
        },
        "paios_senses": {
          "effect": "observe",
          "retry": "forbidden",
          "check_with": "paios_senses",
          "context_inject": [
            "_context"
          ],
          "task_type": "platform:senses"
        }
      },
      "staging": {
        "fake": {
          "command": "node",
          "args": [
            "fake/server.ts"
          ]
        }
      },
      "tests": {
        "contract": "tests/contract.yaml"
      },
      "provenance": {
        "source_commit": "decaff83c56b5e188b229a11e79b32106eeccf43",
        "workshop_run": null,
        "adapter_modules": [
          "server/index.ts"
        ]
      }
    }
  }
}
