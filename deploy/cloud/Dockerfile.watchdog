FROM python:3.13-alpine3.22
RUN apk add --no-cache docker-cli docker-cli-compose
WORKDIR /opt/watchdog
COPY deploy/cloud/release_watchdog.py deploy/cloud/watchdog_platform.py deploy/cloud/release_notice.py deploy/cloud/release_migrations.py deploy/cloud/release_compose.py ./
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 GOMEMLIMIT=12MiB GOGC=100 \
    GOMAXPROCS=1 COMPOSE_PARALLEL_LIMIT=1
ENTRYPOINT ["python3", "release_watchdog.py"]
