# Build the Android helper from its tracked Java source. Only classes.dex enters the runtime.
FROM debian:13.4 AS phone_observation_build
ARG PAIOS_BUILD_MAINLAND_MIRRORS=0
RUN if [ "$PAIOS_BUILD_MAINLAND_MIRRORS" = "1" ]; then sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources; fi && apt-get update && apt-get install -y --no-install-recommends openjdk-21-jdk-headless curl ca-certificates unzip && rm -rf /var/lib/apt/lists/*
WORKDIR /build
# Fixed SDK archives and official repository2-1.xml digests.
RUN curl -fsSL https://dl.google.com/android/repository/platform-36_r02.zip -o platform.zip && \
    curl -fsSL https://dl.google.com/android/repository/build-tools_r36_linux.zip -o tools.zip && \
    printf '%s  %s\n' 2c1a80dd4d9f7d0e6dd336ec603d9b5c55a6f576 platform.zip b0b6376977657e8ad9b969bacf4093601da2c6fb tools.zip | sha1sum -c - && \
    unzip -q platform.zip -d sdk && unzip -q tools.zip -d sdk && rm platform.zip tools.zip
COPY integrations/connectors/phone_executor/PhoneObservation.java .
RUN mkdir classes && javac --release 8 -cp sdk/android-36/android.jar -d classes PhoneObservation.java && \
    java -cp sdk/android-16/lib/d8.jar com.android.tools.r8.D8 --lib sdk/android-36/android.jar --min-api 26 --output classes classes/PhoneObservation.class && \
    jar cf phone-observation.jar -C classes classes.dex

# Build paios-hermes-base first from the locked upstream Dockerfile.
FROM paios-hermes-base:locked
ARG PAIOS_BUILD_MAINLAND_MIRRORS=0
RUN if [ "$PAIOS_BUILD_MAINLAND_MIRRORS" = "1" ]; then sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources; fi && apt-get update && apt-get install -y --no-install-recommends adb openssh-client age zsh fonts-wqy-zenhei && rm -rf /var/lib/apt/lists/*
COPY integrations/connectors/phone_executor/requirements.lock.txt /opt/paios-phone-requirements.txt
RUN if [ "$PAIOS_BUILD_MAINLAND_MIRRORS" = "1" ]; then export UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple; fi && uv venv --python /usr/bin/python3 /opt/paios-phone && uv --no-config pip sync --require-hashes --no-cache --python /opt/paios-phone/bin/python /opt/paios-phone-requirements.txt && uv pip check --python /opt/paios-phone/bin/python
RUN install -d -o 10000 -g 10000 -m 700 /var/lib/paios /var/lib/paios/state /var/lib/paios/state/errands
# PyPI wheels contain source and dist-info/licenses; installation retains both.
COPY deploy/cloud/mijia.requirements.lock.txt /opt/paios/mijia.requirements.lock.txt
RUN uv --no-config pip install --python /opt/hermes/.venv/bin/python --index-url https://pypi.org/simple --only-binary :all: --no-deps --require-hashes -r /opt/paios/mijia.requirements.lock.txt
COPY deploy/cloud/licenses/s6-overlay.COPYING /usr/share/licenses/s6-overlay/COPYING
COPY --chmod=a+rX,go-w integrations /opt/paios/integrations
COPY --from=phone_observation_build --chmod=0644 /build/phone-observation.jar /opt/paios/integrations/connectors/phone_executor/phone-observation.jar
COPY --chmod=a+rX,go-w 01-product-half-finished/backend/services/personal-aios-integration/src/hermes-client.ts /opt/paios/01-product-half-finished/backend/services/personal-aios-integration/src/
COPY --chmod=a+rX,go-w 01-product-half-finished/backend/services/personal-aios-integration/src/native-run.shape.schema.json /opt/paios/01-product-half-finished/backend/services/personal-aios-integration/src/
COPY --chmod=a+rX,go-w deploy/cloud/hermes-product-config.yaml /opt/paios/hermes-product-config.yaml
COPY --chmod=a+rX,go-w deploy/cloud/hermes-init.py /opt/paios/hermes-init.py
COPY --chmod=a+rX,go-w deploy/cloud/workshop-builder-init.py /opt/paios/workshop-builder-init.py
RUN git config --system --add safe.directory /opt/hermes && node /opt/paios/integrations/hermes/verify-producer.mjs --check-running /opt/hermes
# Keep upstream setup, but cloud runs only run_api, never imported profile gateways.
# Seed the product before 01-hermes-setup creates upstream defaults; keep owner config.
RUN rm /etc/cont-init.d/02-reconcile-profiles && printf '#!/command/with-contenv sh\nexec /opt/hermes/.venv/bin/python /opt/paios/hermes-init.py --seed-only\n' > /etc/cont-init.d/00-paios-seed && printf '#!/command/with-contenv sh\nexec /opt/hermes/.venv/bin/python /opt/paios/hermes-init.py\n' > /etc/cont-init.d/03-paios && chmod +x /etc/cont-init.d/00-paios-seed /etc/cont-init.d/03-paios
ENV HERMES_DISABLE_LAZY_INSTALLS=0
CMD ["/opt/hermes/.venv/bin/python", "/opt/paios/hermes-start.py"]
COPY --chmod=a+rX,go-w deploy/cloud/hermes-start.py /opt/paios/hermes-start.py
